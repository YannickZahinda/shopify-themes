{% comment %}
  CUSTOMISED LEARN HERO – Split Layout (Text Left, Image Right)
  Fixed: image max-width constrained, no overflow on desktop or mobile
{% endcomment %}

{%- style -%}
  /* ---------- COMMON & CONTAINER ---------- */
  #clh-{{ section.id }} {
    position: relative;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    /* Fallback colour shown while image loads / when no image is set */
    background: {{ section.settings.bg_color_fallback | default: '#fae0e4' }};
    overflow: hidden;
    color: {{ section.settings.text_text_color | default: section.settings.text_color }};
  }

  /* Background image layer — uses real <img> so object-position works reliably */
  #clh-{{ section.id }} .clh-bg-layer {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  #clh-{{ section.id }} .clh-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.bg_position | default: 'center center' }};
    display: block;
  }

  /* Mobile: shift focal point right to show the subject */
  @media (max-width: 749px) {
    #clh-{{ section.id }} .clh-bg-img {
      object-position: 70% top;
    }
  }

  #clh-{{ section.id }} .clh-container {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  /* Overlay */
  #clh-{{ section.id }}::before {
    content: '';
    position: absolute;
    inset: 0;
    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 1;
    pointer-events: none;
  }

  /* Darken overlay for background image */
  #clh-{{ section.id }}[data-has-bg-image="true"]::before {
    background: {{ section.settings.image_overlay_color }};
    opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};
  }

  /* Fallback if no image is selected */
  #clh-{{ section.id }}.no-bg-image {
    background: {{ section.settings.gradient_bg | default: 'linear-gradient(135deg, #fae0e4 0%, #f1bacc 100%)' }};
  }

  /* ---------- SPLIT LAYOUT ---------- */
  .clh-content-block {
    position: relative;
    z-index: 10;
  }

  /* ---------- DESKTOP ---------- */
  @media (min-width: 750px) {
    #clh-{{ section.id }} .clh-container {
      flex-direction: row;
      align-items: center;
      min-height: {{ section.settings.d_hero_height }}vh;
      padding: 0 5%;
    }

    .clh-content-block {
      flex: 1;
      padding: 0 40px 0 0;
      text-align: left;
    }

    #clh-{{ section.id }} .clh-super-meta {
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: {{ section.settings.text_color }};
      opacity: 0.8;
      margin-bottom: 15px;
    }

    #clh-{{ section.id }} .clh-heading {
      font-size: {{ section.settings.d_heading_size }}px;
      line-height: 1.1;
      margin: 0 0 {{ section.settings.d_heading_mb }}px;
      font-weight: 600;
    }

    #clh-{{ section.id }} .clh-text {
      font-size: {{ section.settings.d_text_size }}px;
      line-height: 1.5;
      margin: 0 0 {{ section.settings.d_text_mb }}px;
      max-width: 500px;
      opacity: 0.9;
    }

    #clh-{{ section.id }} .clh-btn {
      font-size: {{ section.settings.d_btn_font_size }}px;
      padding: {{ section.settings.d_btn_v }}px {{ section.settings.d_btn_h }}px;
      margin-top: 10px;
    }

    #clh-{{ section.id }} .clh-badges {
      display: flex;
      gap: 20px;
      margin-top: 30px;
      font-size: 14px;
      opacity: 0.8;
    }
  }

  /* ---------- MOBILE ---------- */
  @media (max-width: 749px) {
    /* Shift background right to show the person, prevent iOS fixed-bg bug */
    #clh-{{ section.id }} {
      background-attachment: scroll;
      background-position: 68% center;
      background-size: cover;
    }

    /* Overlay very light on mobile — real image shows through */
    #clh-{{ section.id }}::before,
    #clh-{{ section.id }}[data-has-bg-image="true"]::before {
      opacity: 0.18;
    }

    #clh-{{ section.id }} .clh-container {
      padding: 32px 20px 24px;
      min-height: {{ section.settings.m_hero_height }}vh;
      justify-content: center;
      flex-direction: column;
    }

    /* No opaque card — text sits directly over the image with shadows */
    #clh-{{ section.id }} .clh-content-block {
      text-align: center;
      margin: 0 auto;
      flex: 0 0 auto;
      width: 100%;
      background: none;
    }

    /* Deep text-shadows keep headings readable on any background */
    #clh-{{ section.id }} .clh-heading,
    #clh-{{ section.id }} .clh-super-meta {
      text-shadow:
        0 2px 24px rgba(0, 0, 0, 0.85),
        0 1px 6px rgba(0, 0, 0, 1);
    }

    #clh-{{ section.id }} .clh-text {
      text-shadow: 0 1px 12px rgba(0, 0, 0, 0.8);
    }

    #clh-{{ section.id }} .clh-super-meta {
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-bottom: 15px;
      opacity: 0.8;
    }

    #clh-{{ section.id }} .clh-heading {
      font-size: {{ section.settings.m_heading_size }}px;
      line-height: 1.15;
      margin: 0 0 {{ section.settings.m_heading_mb }}px;
    }

    #clh-{{ section.id }} .clh-text {
      font-size: {{ section.settings.m_text_size }}px;
      line-height: 1.5;
      margin: 0 0 {{ section.settings.m_text_mb }}px;
      opacity: 0.9;
    }

    #clh-{{ section.id }} .clh-btn {
      font-size: {{ section.settings.m_btn_font_size }}px;
      padding: {{ section.settings.m_btn_v }}px {{ section.settings.m_btn_h }}px;
      margin-top: 10px;
    }

    #clh-{{ section.id }} .clh-badges {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 15px;
      margin-top: 25px;
      font-size: 13px;
      opacity: 0.8;
    }
  }

  /* ---------- BUTTON STYLES ---------- */
  #clh-{{ section.id }} .clh-btn {
    display: inline-block;
    color: {{ section.settings.btn_text_color }} !important;
    -webkit-text-fill-color: {{ section.settings.btn_text_color }};
    background: {{ section.settings.btn_bg_color }};
    border: 2px solid {{ section.settings.btn_bg_color }};
    border-radius: {{ section.settings.btn_radius }}px;
    text-decoration: none;
    font-weight: 600;
    transition: background 0.3s ease, color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
    cursor: pointer;
    position: relative;
    z-index: 6;
    box-shadow: 0 4px 14px rgba(0,0,0,0.15);
  }

  #clh-{{ section.id }} .clh-btn:hover {
    background: transparent;
    color: {{ section.settings.btn_bg_color }} !important;
    -webkit-text-fill-color: {{ section.settings.btn_bg_color }};
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.2);
  }
{%- endstyle -%}

<div
  id="clh-{{ section.id }}"
  class="customised-learn-hero{% if section.settings.bg_image == blank %} no-bg-image{% endif %}"
  {% if section.settings.bg_image != blank %}data-has-bg-image="true"{% endif %}
>

  {% if section.settings.bg_image != blank %}
    <div class="clh-bg-layer">
      <img
        class="clh-bg-img"
        src="{{ section.settings.bg_image | image_url: width: 1200 }}"
        srcset="{{ section.settings.bg_image | image_url: width: 750 }} 750w,
                {{ section.settings.bg_image | image_url: width: 1200 }} 1200w,
                {{ section.settings.bg_image | image_url: width: 1920 }} 1920w"
        sizes="100vw"
        alt=""
        loading="eager"
        fetchpriority="high"
        width="{{ section.settings.bg_image.width }}"
        height="{{ section.settings.bg_image.height }}"
      >
    </div>
  {% endif %}

  <div class="clh-container">

    <!-- LEFT: Text Content -->
    <div class="clh-content-block">
      {%- if section.settings.super_meta != blank -%}
        <div class="clh-super-meta">{{ section.settings.super_meta | escape }}</div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="clh-heading">{{ section.settings.heading | newline_to_br }}</h1>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="clh-text">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      {%- if section.settings.btn_text != blank and section.settings.btn_link != blank -%}
        <div style="position: relative; z-index: 6;">
          <a href="{{ section.settings.btn_link }}" class="clh-btn">
            {{ section.settings.btn_text | escape }}
          </a>
        </div>
      {%- endif -%}

      {%- if section.settings.badge_1 != blank or section.settings.badge_2 != blank -%}
        <div class="clh-badges">
          {%- if section.settings.badge_1 != blank -%}
            <span>● {{ section.settings.badge_1 }}</span>
          {%- endif -%}
          {%- if section.settings.badge_2 != blank -%}
            <span>● {{ section.settings.badge_2 }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Customised Learn Hero",
  "settings": [
    {
      "type": "header",
      "content": "Background Image"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Hero Background Image",
      "info": "Recommended size: 1920x1080px or larger."
    },
    {
      "type": "select",
      "id": "bg_size",
      "label": "Background Size",
      "options": [
        { "value": "cover", "label": "Cover (Fill completely)" },
        { "value": "contain", "label": "Contain (Show entire image)" },
        { "value": "auto", "label": "Auto (Original size)" }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "bg_position",
      "label": "Background Position",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "top center", "label": "Top" },
        { "value": "bottom center", "label": "Bottom" },
        { "value": "left center", "label": "Left" },
        { "value": "right center", "label": "Right" }
      ],
      "default": "center center"
    },
    {
      "type": "select",
      "id": "bg_repeat",
      "label": "Background Repeat",
      "options": [
        { "value": "no-repeat", "label": "No Repeat" },
        { "value": "repeat", "label": "Repeat" },
        { "value": "repeat-x", "label": "Repeat Horizontally" },
        { "value": "repeat-y", "label": "Repeat Vertically" }
      ],
      "default": "no-repeat"
    },
    {
      "type": "select",
      "id": "bg_attachment",
      "label": "Background Attachment",
      "options": [
        { "value": "scroll", "label": "Scroll" },
        { "value": "fixed", "label": "Fixed (Parallax effect)" }
      ],
      "default": "scroll"
    },
    {
      "type": "header",
      "content": "Gradient Fallback (if no image)"
    },
    {
      "type": "text",
      "id": "gradient_bg",
      "label": "CSS Background (Gradient/Color)",
      "default": "linear-gradient(135deg, #fae0e4 0%, #f1bacc 100%)"
    },
    {
      "type": "color",
      "id": "bg_color_fallback",
      "label": "Solid Color Fallback",
      "default": "#fae0e4"
    },
    {
      "type": "header",
      "content": "Overlay Settings"
    },
    {
      "type": "color",
      "id": "image_overlay_color",
      "label": "Image Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "label": "Image Overlay Opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Original Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Original Overlay Opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "super_meta",
      "label": "Eyebrow Text",
      "default": "INTIMATE WELLNESS · INDIA"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Discover Pleasure,\nOwn Your Journey."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subheading",
      "default": "Premium intimate wellness, delivered discreetly to your door. Curated for every body."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "badge_1",
      "label": "Footer Badge 1",
      "default": "Discreet Packaging"
    },
    {
      "type": "text",
      "id": "badge_2",
      "label": "Footer Badge 2",
      "default": "All India Delivery"
    },
    {
      "type": "header",
      "content": "Text and Button Styling"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#2b1c4b"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button Background / Border",
      "default": "#7B1E3A"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "btn_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 50
    },
    {
      "type": "header",
      "content": "Desktop Layout Sizes"
    },
    { "type": "range", "id": "d_hero_height", "label": "Section height (vh)", "min": 50, "max": 100, "step": 5, "default": 75 },
    { "type": "range", "id": "d_heading_size", "label": "Heading size", "min": 30, "max": 80, "step": 2, "unit": "px", "default": 64 },
    { "type": "range", "id": "d_heading_mb", "label": "Heading bottom margin", "min": 0, "max": 60, "step": 5, "unit": "px", "default": 20 },
    { "type": "range", "id": "d_text_size", "label": "Text size", "min": 14, "max": 30, "step": 1, "unit": "px", "default": 22 },
    { "type": "range", "id": "d_text_mb", "label": "Text bottom margin", "min": 0, "max": 60, "step": 5, "unit": "px", "default": 35 },
    { "type": "range", "id": "d_btn_font_size", "label": "Button font size", "min": 14, "max": 24, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "d_btn_v", "label": "Btn vertical pad", "min": 5, "max": 30, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "d_btn_h", "label": "Btn horizontal pad", "min": 10, "max": 60, "step": 2, "unit": "px", "default": 40 },
    {
      "type": "header",
      "content": "Mobile Layout Sizes"
    },
    { "type": "range", "id": "m_hero_height", "label": "Section height (vh)", "min": 60, "max": 100, "step": 5, "default": 85 },
    { "type": "range", "id": "m_heading_size", "label": "Heading size", "min": 24, "max": 48, "step": 2, "unit": "px", "default": 36 },
    { "type": "range", "id": "m_heading_mb", "label": "Heading bottom margin", "min": 0, "max": 40, "step": 5, "unit": "px", "default": 15 },
    { "type": "range", "id": "m_text_size", "label": "Text size", "min": 14, "max": 22, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "m_text_mb", "label": "Text bottom margin", "min": 0, "max": 40, "step": 5, "unit": "px", "default": 25 },
    { "type": "range", "id": "m_btn_font_size", "label": "Button font size", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "m_btn_v", "label": "Btn vertical pad", "min": 5, "max": 25, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "m_btn_h", "label": "Btn horizontal pad", "min": 10, "max": 50, "step": 1, "unit": "px", "default": 35 }
  ],
  "presets": [
    {
      "name": "Customised Learn Hero",
      "category": "Image"
    }
  ]
}
{% endschema %}