{% comment %}
  Custom FAQ Section - Figma Style with Options
  Save this as: sections/custom-faq.liquid
{% endcomment %}

<style>
/* Custom FAQ Section Styles - Arousique Premium */
.custom-faq-section {
  padding: 80px 20px;
  width: 100%;
  box-sizing: border-box;
  background: linear-gradient(160deg, #FFF8F4 0%, #F6EEF2 100%);
}

.faq-container {
  max-width: 750px;
  margin: 0 auto;
}

.faq-heading {
  text-align: center;
  font-size: 48px;
  font-weight: 700;
  margin-bottom: 50px;
  color: {{ section.settings.heading_color }};
  letter-spacing: -1px;
  font-family: 'Tomato Grotesk', sans-serif;
}

.faq-accordion {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.faq-item {
  background: #FFFFFF;
  overflow: hidden;
  transition: all 0.25s ease;
  border: 1px solid {{ section.settings.border_color }};
  border-radius: 14px;
  box-shadow: 0 2px 8px rgba(45, 27, 46, 0.04);
}

.faq-item:hover {
  background: linear-gradient(160deg, #FFFFFF 0%, #FDF6F9 100%);
  box-shadow: 0 4px 16px rgba(45, 27, 46, 0.08);
  transform: translateY(-1px);
}

.faq-item.active {
  border-color: {{ section.settings.heading_color }};
  box-shadow: 0 4px 20px rgba(231, 84, 128, 0.12);
}

.faq-question {
  width: 100%;
  padding: 22px 28px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: transparent;
  border: none;
  cursor: pointer;
  text-align: left;
  font-family: inherit;
  transition: all 0.2s ease;
  gap: 24px;
}

.faq-question:hover {
  background-color: rgba(212, 175, 55, 0.03);
}

.faq-question-text {
  font-size: 17px;
  font-weight: 600;
  color: #2D1B2E;
  line-height: 1.5;
  flex: 1;
  letter-spacing: -0.2px;
  font-family: 'Tomato Grotesk', sans-serif;
}

.faq-icon {
  flex-shrink: 0;
  width: 20px;
  height: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #D4AF37;
  transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

.faq-item.active .faq-icon {
  transform: rotate(45deg);
  color: #E75480;
}

.faq-icon svg {
  width: 20px;
  height: 20px;
}

.faq-answer {
  overflow: hidden;
  transition: max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1),
              opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1),
              padding 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  max-height: 0;
  opacity: 0;
}

.faq-item.active .faq-answer {
  max-height: 800px;
  opacity: 1;
}

.faq-answer-content {
  padding: 0 32px 28px 32px;
  color: #8B6B7A;
  font-size: 16px;
  line-height: 1.65;
  letter-spacing: -0.1px;
}

.faq-answer-content p {
  margin: 0 0 14px 0;
}

.faq-answer-content p:last-child {
  margin-bottom: 0;
}

.faq-answer-content ul,
.faq-answer-content ol {
  margin: 14px 0;
  padding-left: 28px;
}

.faq-answer-content li {
  margin-bottom: 10px;
  line-height: 1.6;
}

.faq-answer-content a {
  color: {{ section.settings.heading_color }};
  text-decoration: underline;
  text-underline-offset: 2px;
  transition: color 0.2s ease;
}

.faq-answer-content a:hover {
  color: #E75480;
}

.faq-question:focus {
  outline: 2px solid {{ section.settings.heading_color }};
  outline-offset: -2px;
}

.faq-question:focus:not(:focus-visible) {
  outline: none;
}

/* See More Button */
.faq-see-more-wrapper {
  text-align: center;
  margin-top: 40px;
}

.faq-see-more-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 14px 32px;
  background: transparent;
  border: 2px solid {{ section.settings.heading_color }};
  color: {{ section.settings.heading_color }};
  font-size: 16px;
  font-weight: 600;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.3s ease;
  font-family: inherit;
}

.faq-see-more-btn:hover {
  background: {{ section.settings.heading_color }};
  color: #ffffff;
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(123, 30, 58, 0.2);
}

.faq-see-more-btn svg {
  transition: transform 0.3s ease;
}

.faq-see-more-btn.expanded svg {
  transform: rotate(180deg);
}

.faq-item.hidden-faq {
  display: none;
}

.faq-item.hidden-faq.show {
  display: block;
}

@media screen and (max-width: 768px) {
  .custom-faq-section {
    padding: 60px 20px;
  }

  .faq-heading {
    font-size: 36px;
    margin-bottom: 40px;
  }

  .faq-question {
    padding: 20px 24px;
    gap: 16px;
  }

  .faq-question-text {
    font-size: 16px;
  }

  .faq-answer-content {
    padding: 0 24px 24px 24px;
    font-size: 15px;
  }
  
  .faq-see-more-btn {
    padding: 12px 24px;
    font-size: 15px;
  }
}

@media screen and (max-width: 480px) {
  .custom-faq-section {
    padding: 40px 16px;
  }

  .faq-heading {
    font-size: 32px;
    margin-bottom: 32px;
  }

  .faq-question {
    padding: 18px 20px;
  }

  .faq-question-text {
    font-size: 15px;
  }

  .faq-icon {
    width: 18px;
    height: 18px;
  }

  .faq-icon svg {
    width: 18px;
    height: 18px;
  }

  .faq-answer-content {
    padding: 0 20px 20px 20px;
    font-size: 14px;
  }
  
  .faq-see-more-btn {
    padding: 10px 20px;
    font-size: 14px;
  }
}
</style>

<div class="custom-faq-section">
  <div class="faq-container">
    {% if section.settings.heading != blank %}
      <h2 class="faq-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="faq-accordion">
      {% for block in section.blocks %}
        <div class="faq-item {% if forloop.index > section.settings.initial_visible %}hidden-faq{% endif %}" {{ block.shopify_attributes }}>
          <button class="faq-question" aria-expanded="false" aria-controls="faq-answer-{{ block.id }}">
            <span class="faq-question-text">{{ block.settings.question }}</span>
            <span class="faq-icon">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M10 4V16M4 10H16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </span>
          </button>
          <div class="faq-answer" id="faq-answer-{{ block.id }}">
            <div class="faq-answer-content">
              {{ block.settings.answer }}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    {% if section.blocks.size > section.settings.initial_visible %}
      <div class="faq-see-more-wrapper">
        <button class="faq-see-more-btn" id="faq-see-more">
          <span class="see-more-text">{{ section.settings.see_more_text }}</span>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    {% endif %}
  </div>
</div>

<script>
  (function() {
    // FAQ Accordion functionality
    const faqButtons = document.querySelectorAll('.faq-question');
    
    faqButtons.forEach(button => {
      button.addEventListener('click', function() {
        const isExpanded = this.getAttribute('aria-expanded') === 'true';
        const answer = this.nextElementSibling;
        const item = this.parentElement;
        
        // Toggle current item
        this.setAttribute('aria-expanded', !isExpanded);
        item.classList.toggle('active');
      });
    });

    // See More functionality
    const seeMoreBtn = document.getElementById('faq-see-more');
    if (seeMoreBtn) {
      const hiddenFaqs = document.querySelectorAll('.hidden-faq');
      const seeMoreText = seeMoreBtn.querySelector('.see-more-text');
      const seeLessText = '{{ section.settings.see_less_text }}';
      const seeMoreTextOriginal = '{{ section.settings.see_more_text }}';
      
      seeMoreBtn.addEventListener('click', function() {
        const isExpanded = this.classList.contains('expanded');
        
        if (isExpanded) {
          // Collapse
          hiddenFaqs.forEach(faq => {
            faq.classList.remove('show');
          });
          this.classList.remove('expanded');
          seeMoreText.textContent = seeMoreTextOriginal;
          
          // Scroll to FAQ section
          document.querySelector('.faq-accordion').scrollIntoView({ 
            behavior: 'smooth', 
            block: 'start' 
          });
        } else {
          // Expand
          hiddenFaqs.forEach(faq => {
            faq.classList.add('show');
          });
          this.classList.add('expanded');
          seeMoreText.textContent = seeLessText;
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Custom FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "FAQs"
    },
    {
      "type": "color",
      "id": "heading_color",
