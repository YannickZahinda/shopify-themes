<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}">
  {% liquid
    assign total_blocks = section.blocks.size
    assign grid_columns = total_blocks | at_most: 4
    assign last_row_count = total_blocks | minus: 1 | modulo: 4 | plus: 1
    assign tablet_last_row_count = total_blocks | minus: 1 | modulo: 3 | plus: 1
    assign has_isolated_grid_item_desktop = false
    assign has_isolated_grid_item_tablet = false

    if total_blocks > 4 and last_row_count == 1
      assign has_isolated_grid_item_desktop = true
    endif

    if total_blocks > 3 and tablet_last_row_count == 1
      assign has_isolated_grid_item_tablet = true
    endif
  %}
  
  <div class="footer-content spacing-style
      {% if has_isolated_grid_item_desktop %}footer-content--isolated-grid-item-desktop{% endif %}
      {% if has_isolated_grid_item_tablet %}footer-content--isolated-grid-item-tablet{% endif %}"
    style="{% render 'spacing-style', settings: section.settings %}
      --footer-gap: {{ section.settings.gap }}px;
      --grid-columns: {{ grid_columns }};
      --last-row-count: {{ last_row_count }};
      --tablet-last-row-count: {{ tablet_last_row_count }};">
    {% content_for 'blocks' %}
  </div>

  {% if section.settings.show_copyright_bar %}
  <div class="footer-copyright" style="background-color: {{ section.settings.copyright_bg_color }}; color: {{ section.settings.copyright_text_color }};">
    <div class="footer-copyright-content">
      <p>{{ section.settings.copyright_text }}</p>
      {% if section.settings.show_privacy_links %}
      <div class="footer-legal-links">
        <a href="{{ section.settings.privacy_policy_url }}">{{ section.settings.privacy_text }}</a>
        <span class="separator">|</span>
        <a href="{{ section.settings.terms_url }}">{{ section.settings.terms_text }}</a>
      </div>
      {% endif %}
    </div>
  </div>
  {% endif %}
</div>

{% stylesheet %}
  .footer-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--footer-gap);
  }

  /* Mobile: Single column layout */
  @media screen and (max-width: 749px) {
    .footer-content {
      grid-template-columns: 1fr;
    }
  }

  /* Tablet: 2 column layout */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .footer-content {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-flow: row;
    }
    .footer-content--isolated-grid-item-tablet > :last-child {
      grid-column: 1 / -1;
    }
  }

  /* Desktop: 4 column layout matching Figma */
  @media screen and (min-width: 990px) {
    .footer-content {
      grid-template-columns: 2fr 1fr 1fr 1.5fr;
      align-items: start;
    }

    /* Force 4 columns when there are 4 blocks */
    .footer-content:has(> :nth-child(4)) {
      grid-template-columns: 2fr 1fr 1fr 1.5fr;
    }

    .footer-content[style*='--grid-columns: 1'] {
      justify-items: center;
    }

    .footer-content--isolated-grid-item-desktop > :last-child {
      grid-column: 1 / -1;
    }
  }

  /* Copyright bar styling */
  .footer-copyright {
    margin-top: 40px;
    padding: 20px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-copyright-content {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 14px;
  }

  .footer-copyright p {
    margin: 0;
  }

  .footer-legal-links {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .footer-legal-links a {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .footer-legal-links a:hover {
    opacity: 0.7;
  }

  .footer-legal-links .separator {
    opacity: 0.5;
  }

  @media screen and (max-width: 749px) {
    .footer-copyright-content {
      flex-direction: column;
      text-align: center;
      gap: 12px;
    }
  }
{% endstylesheet %}

