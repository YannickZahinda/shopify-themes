{% comment %}
  Article Grid Section with Full Customization
  Place this in: sections/custom-article-grid.liquid
{% endcomment %}

<style>
  .article-grid-section {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
  }
  
  .article-grid-container {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }
  
  .article-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: {{ section.settings.grid_gap }}px;
  }
  
  .article-card {
    background: {{ section.settings.card_background }};
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  
  .article-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
  }
  
  .article-image {
    width: 100%;
    height: {{ section.settings.image_height }}px;
    object-fit: cover;
    display: block;
  }
  
  .article-content {
    padding: {{ section.settings.content_padding }}px;
  }
  
  .article-title {
    font-size: {{ section.settings.title_size }}px;
    font-weight: {{ section.settings.title_weight }};
    color: {{ section.settings.title_color }};
    margin: 0 0 15px 0;
    line-height: 1.3;
  }
  
  .article-meta {
    font-size: {{ section.settings.meta_size }}px;
    color: {{ section.settings.meta_color }};
    margin-bottom: 12px;
  }
  
  .article-excerpt {
    font-size: {{ section.settings.excerpt_size }}px;
    color: {{ section.settings.excerpt_color }};
    line-height: 1.6;
    margin-bottom: 20px;
  }
  
  .article-button {
    display: inline-block;
    padding: {{ section.settings.button_padding_v }}px {{ section.settings.button_padding_h }}px;
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ section.settings.button_radius }}px;
    font-size: {{ section.settings.button_size }}px;
    font-weight: {{ section.settings.button_weight }};
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }
  
  .article-button:hover {
    background: {{ section.settings.button_hover_background }};
    color: {{ section.settings.button_hover_text_color }};
    transform: scale(1.05);
  }
  
  @media (max-width: 768px) {
    .article-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="article-grid-section">
  <div class="article-grid-container">
    <div class="article-grid">
      {% for block in section.blocks %}
        <article class="article-card" {{ block.shopify_attributes }}>
          {% if block.settings.image %}
            <img 
              src="{{ block.settings.image | img_url: '800x' }}" 
              alt="{{ block.settings.image.alt | default: block.settings.title }}"
              class="article-image"
              loading="lazy"
            >
          {% endif %}
          
          <div class="article-content">
            {% if block.settings.title != blank %}
              <h3 class="article-title">{{ block.settings.title }}</h3>
            {% endif %}
            
            {% if block.settings.meta != blank %}
              <div class="article-meta">{{ block.settings.meta }}</div>
            {% endif %}
            
            {% if block.settings.excerpt != blank %}
              <p class="article-excerpt">{{ block.settings.excerpt }}</p>
            {% endif %}
            
            {% if block.settings.button_text != blank %}
              <a href="{{ block.settings.button_link }}" class="article-button">
                {{ block.settings.button_text }}
              </a>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Article Grid",
  "tag": "section",
  "class": "section-article-grid",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 1000,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Container Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Gap Between Cards",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Section Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Section Padding Bottom",
      "default": 60
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card Background",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Card Settings"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Card Border Radius",
      "default": 12
    },
    {
      "type": "range",
      "id": "image_height",
      "min": 200,
      "max": 500,
      "step": 20,
      "unit": "px",
      "label": "Image Height",
      "default": 300
    },
    {
      "type": "range",
      "id": "content_padding",
      "min": 15,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Content Padding",
      "default": 25
    },
    {
      "type": "header",
      "content": "Title Settings"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 16,
      "max": 36,
      "step": 2,
      "unit": "px",
      "label": "Title Font Size",
      "default": 22
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title Font Weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Meta Text Settings"
    },
    {
      "type": "range",
      "id": "meta_size",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Meta Font Size",
      "default": 13
    },
    {
      "type": "color",
      "id": "meta_color",
      "label": "Meta Color",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Excerpt Settings"
    },
    {
      "type": "range",
      "id": "excerpt_size",
      "min": 13,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Excerpt Font Size",
      "default": 15
    },
    {
      "type": "color",
      "id": "excerpt_color",
      "label": "Excerpt Color",
      "default": "#333333"
    },
    {
      "type": "header",
      "content": "Button Settings"
    },
    {
      "type": "range",
      "id": "button_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Button Font Size",
      "default": 15
    },
    {
      "type": "select",
      "id": "button_weight",
      "label": "Button Font Weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "button_padding_v",
      "min": 8,
      "max": 25,
      "step": 1,
      "unit": "px",
      "label": "Button Vertical Padding",
      "default": 12
    },
    {
      "type": "range",
      "id": "button_padding_h",
      "min": 15,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Button Horizontal Padding",
      "default": 30
    },
    {
      "type": "range",
      "id": "button_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Button Border Radius",
      "default": 24
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button Background",
      "default": "#FF6B8A"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Button Hover Background",
      "default": "#FF4D73"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Button Hover Text Color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "article",
      "name": "Article Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Article Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Article Title",
          "default": "Article Title Here"
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Meta Information",
          "default": "By Author | Date | Read Time",
          "info": "Author, date, read time, etc."
        },
        {
          "type": "textarea",
          "id": "excerpt",
          "label": "Article Excerpt",
          "default": "A brief description of the article content goes here..."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Read More"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Article Grid",
      "blocks": [
        {
          "type": "article",
          "settings": {
            "title": "Why Self-Love Isn't Selfish, It's Sacred",
            "meta": "arousique | June 13, 2025 | 2 min read",
            "excerpt": "We've all been told to give, care, support. But when...",
            "button_text": "Read More"
          }
        },
        {
          "type": "article",
          "settings": {
            "title": "Pleasure Is Self-Care: Here's Why It Matters",
            "meta": "arousique | June 13, 2025 | 2 min read",
            "excerpt": "In a world that constantly tells us to hustle, care...",
            "button_text": "Read More"
          }
        },
        {
          "type": "article",
          "settings": {
            "title": "Let's Talk Foreplay: Because It's More Than Just a Warm-Up",
            "meta": "digitaltalesdata | May 20, 2025 | 4:09 pm",
            "excerpt": "Foreplay isn't just about getting from A to B. It's about slowing down, tuning...",
            "button_text": "Read More"
          }
        }
      ]
    }
  ]
}
{% endschema %}