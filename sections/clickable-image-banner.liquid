{% comment %}
  CLICKABLE IMAGE BANNER - Brand New Section
  Simple image banner with desktop/mobile versions and clickable link
{% endcomment %}

<style>
  .clickable-img-banner-{{ section.id }} {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    line-height: 0;
  }

  .clickable-img-banner-{{ section.id }} a {
    display: block;
    width: 100%;
    text-decoration: none;
    position: relative;
  }

  .clickable-img-banner-{{ section.id }} img {
    width: 100%;
    height: auto;
    display: block;
    margin: 0;
    padding: 0;
  }

  .clickable-img-banner-{{ section.id }} .mobile-banner {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .clickable-img-banner-{{ section.id }} .desktop-banner {
      display: none;
    }
    .clickable-img-banner-{{ section.id }} .mobile-banner {
      display: block;
    }
  }

  .clickable-img-banner-{{ section.id }} a:hover img {
    opacity: 0.98;
  }
</style>

<div class="clickable-img-banner-{{ section.id }}">
  {% if section.settings.banner_link != blank %}
    <a href="{{ section.settings.banner_link }}">
  {% endif %}
  
  {% if section.settings.desktop_img != blank %}
    <img 
      class="desktop-banner"
      src="{{ section.settings.desktop_img | img_url: 'master' }}" 
      alt="{{ section.settings.desktop_img.alt | escape }}"
      width="{{ section.settings.desktop_img.width }}"
      height="{{ section.settings.desktop_img.height }}"
      loading="lazy"
    >
  {% else %}
    <div class="desktop-banner" style="background: #f5f5f5; padding: 100px 20px; text-align: center;">
      <p style="color: #999;">Upload Desktop Image</p>
    </div>
  {% endif %}

  {% if section.settings.mobile_img != blank %}
    <img 
      class="mobile-banner"
      src="{{ section.settings.mobile_img | img_url: 'master' }}" 
      alt="{{ section.settings.mobile_img.alt | escape }}"
      width="{{ section.settings.mobile_img.width }}"
      height="{{ section.settings.mobile_img.height }}"
      loading="lazy"
    >
  {% else %}
    <div class="mobile-banner" style="background: #f5f5f5; padding: 80px 20px; text-align: center;">
      <p style="color: #999;">Upload Mobile Image</p>
    </div>
  {% endif %}

  {% if section.settings.banner_link != blank %}
    </a>
  {% endif %}
</div>

{% schema %}
{
  "name": "🖼️ Clickable Image Banner",
  "class": "clickable-image-banner-section",
  "settings": [
    {
      "type": "header",
      "content": "IMAGES"
    },
    {
      "type": "image_picker",
      "id": "desktop_img",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_img",
      "label": "Mobile Image"
    },
    {
      "type": "header",
      "content": "LINK"
    },
    {
      "type": "url",
      "id": "banner_link",
      "label": "Banner Link URL",
      "info": "Example: /collections/all"
    }
  ],
  "presets": [
    {
      "name": "🖼️ Clickable Image Banner"
    }
  ]
}
{% endschema %}