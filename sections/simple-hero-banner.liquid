{% assign banner_id = section.id | replace: '_', '' | downcase %}

{% style %}
  .banner-section-{{ banner_id }} {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw) !important;
    margin-right: calc(50% - 50vw) !important;
    left: 0;
    right: 0;
    display: block;
    overflow: hidden;
    padding-left: 0 !important;
    padding-right: 0 !important;
    background-color: {{ section.settings.section_background_color }};
  }

  /* Background image — natural aspect ratio */
  .banner-bg-img-{{ banner_id }} {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    object-position: center top;
    vertical-align: bottom;
  }

  /* Placeholder when no image */
  .banner-placeholder-{{ banner_id }} {
    min-height: {{ section.settings.banner_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .banner-placeholder-{{ banner_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
    opacity: 0.15;
  }

  /* Overlay on top of background image */
  .banner-overlay-{{ banner_id }} {
    position: absolute;
    inset: 0;
    background-color: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 2;
    pointer-events: none;
  }

  /* ── Content container ── */
  .banner-content-{{ banner_id }} {
    {% if section.settings.background_image %}
      position: absolute;
      inset: 0;
    {% endif %}
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: {% if section.settings.text_alignment == 'left' %}flex-start{% elsif section.settings.text_alignment == 'right' %}flex-end{% else %}center{% endif %};
    justify-content: center;
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_horizontal }}px {{ section.settings.padding_bottom }}px;
    text-align: {{ section.settings.text_alignment }};
  }

  /* ── Eyebrow icon ── */
  .banner-eyebrow-{{ banner_id }} {
    font-size: {{ section.settings.eyebrow_size }}px;
    color: {{ section.settings.eyebrow_color }};
    margin: 0 0 12px;
    line-height: 1;
    display: block;
  }

  /* ── Heading ── */
  .banner-heading-{{ banner_id }} {
    font-size: {{ section.settings.heading_size }}px;
    color: {{ section.settings.heading_color }};
    margin: 0 0 20px;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  /* Italic accent word inside heading */
  .banner-heading-accent-{{ banner_id }} {
    font-style: italic;
    color: {{ section.settings.heading_accent_color }};
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
  }

  /* ── Bullet lines ── */
  .banner-bullets-{{ banner_id }} {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0 0 24px;
  }

  .banner-bullet-{{ banner_id }} {
    font-size: {{ section.settings.bullets_size }}px;
    color: {{ section.settings.bullets_color }};
    margin: 0;
    line-height: 1.5;
    font-weight: 400;
  }

  /* ── Decorative divider ── */
  .banner-divider-{{ banner_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 24px;
    width: 100%;
    max-width: 320px;
    {% if section.settings.text_alignment == 'center' %}
      align-self: center;
    {% elsif section.settings.text_alignment == 'right' %}
      align-self: flex-end;
    {% else %}
      align-self: flex-start;
    {% endif %}
  }

  .banner-divider-line-{{ banner_id }} {
    flex: 1;
    height: 1px;
    background: {{ section.settings.divider_color }};
    opacity: 0.4;
  }

  .banner-divider-icon-{{ banner_id }} {
    font-size: {{ section.settings.divider_icon_size }}px;
    color: {{ section.settings.divider_color }};
    line-height: 1;
    flex-shrink: 0;
  }

  /* ── Tagline ── */
  .banner-tagline-{{ banner_id }} {
    font-size: {{ section.settings.tagline_size }}px;
    color: {{ section.settings.tagline_color }};
    margin: 0 0 24px;
    line-height: 1.6;
    max-width: {{ section.settings.tagline_max_width }}px;
    font-style: italic;
    {% if section.settings.text_alignment == 'center' %}
      align-self: center;
    {% endif %}
  }

  /* ── Original subheading (legacy) ── */
  .banner-subheading-{{ banner_id }} {
    font-size: {{ section.settings.subheading_size }}px;
    color: {{ section.settings.subheading_color }};
    margin: 0 0 24px;
    line-height: 1.5;
  }

  /* ── Button ── */
  .banner-button-wrapper-{{ banner_id }} {
    display: flex;
    {% if section.settings.text_alignment == 'left' %}
      justify-content: flex-start;
    {% elsif section.settings.text_alignment == 'right' %}
      justify-content: flex-end;
    {% else %}
      justify-content: center;
    {% endif %}
  }

  .banner-button-{{ banner_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ section.settings.button_padding_vertical }}px {{ section.settings.button_padding_horizontal }}px;
    background-color: {{ section.settings.button_background_color }};
    color: {{ section.settings.button_text_color }} !important;
    -webkit-text-fill-color: {{ section.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ section.settings.button_border_radius }}px;
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: 600;
    border: 2px solid {{ section.settings.button_background_color }};
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
  }

  .banner-button-{{ banner_id }}:hover {
    background-color: {{ section.settings.button_hover_background }};
    border-color: {{ section.settings.button_hover_background }};
    color: {{ section.settings.button_text_color }} !important;
    -webkit-text-fill-color: {{ section.settings.button_text_color }};
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }

  /* ── Collection page image fix ── */
  .template-collection .product-card img,
  .template-collection product-card img,
  .template-collection .product-grid__card img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    padding: 0 !important;
    max-width: 100% !important;
    max-height: 100% !important;
    border-radius: 0 !important;
  }

  .template-collection .card-gallery,
  .template-collection .product-card__image,
  .template-collection .product-media-container {
    aspect-ratio: 1 / 1 !important;
    overflow: hidden !important;
  }

  /* ── Responsive ── */
  @media screen and (max-width: 989px) {
    .banner-heading-{{ banner_id }} {
      font-size: {{ section.settings.heading_size | times: 0.78 | round }}px;
    }
    .banner-bullets-{{ banner_id }},
    .banner-subheading-{{ banner_id }},
    .banner-tagline-{{ banner_id }} {
      font-size: {{ section.settings.bullets_size | times: 0.9 | round }}px;
    }
    .banner-content-{{ banner_id }} {
      padding: {{ section.settings.padding_top | times: 0.75 | round }}px {{ section.settings.padding_horizontal | times: 0.8 | round }}px {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .banner-heading-{{ banner_id }} {
      font-size: {{ section.settings.heading_size | times: 0.62 | round }}px;
      margin-bottom: 14px;
    }
    .banner-bullet-{{ banner_id }} {
      font-size: {{ section.settings.bullets_size | times: 0.88 | round }}px;
    }
    .banner-tagline-{{ banner_id }} {
      font-size: {{ section.settings.tagline_size | times: 0.88 | round }}px;
    }
    .banner-content-{{ banner_id }} {
      padding: {{ section.settings.padding_top | times: 0.6 | round }}px 20px {{ section.settings.padding_bottom | times: 0.6 | round }}px;
    }
    .banner-button-{{ banner_id }} {
      padding: {{ section.settings.button_padding_vertical | times: 0.9 | round }}px {{ section.settings.button_padding_horizontal | times: 0.9 | round }}px;
      font-size: {{ section.settings.button_font_size | times: 0.9 | round }}px;
    }
  }
{% endstyle %}

<div class="banner-section-{{ banner_id }}" {{ section.shopify_attributes }}>

  {%- if section.settings.background_image -%}
    <picture>
      {%- if section.settings.mobile_background_image -%}
        <source media="(max-width: 749px)"
          srcset="{{ section.settings.mobile_background_image | image_url: width: 750 }} 750w,
                  {{ section.settings.mobile_background_image | image_url: width: 1000 }} 1000w"
          sizes="100vw"
          width="{{ section.settings.mobile_background_image.width }}"
          height="{{ section.settings.mobile_background_image.height }}">
      {%- else -%}
        <source media="(max-width: 749px)"
          srcset="{{ section.settings.background_image | image_url: width: 750 }} 750w,
                  {{ section.settings.background_image | image_url: width: 1000 }} 1000w"
          sizes="100vw">
      {%- endif -%}
      <img
        class="banner-bg-img-{{ banner_id }}"
        src="{{ section.settings.background_image | image_url: width: 2000 }}"
        srcset="{{ section.settings.background_image | image_url: width: 1000 }} 1000w,
                {{ section.settings.background_image | image_url: width: 1500 }} 1500w,
                {{ section.settings.background_image | image_url: width: 2000 }} 2000w"
        sizes="100vw"
        alt=""
        width="{{ section.settings.background_image.width }}"
        height="{{ section.settings.background_image.height }}"
        loading="eager"
        fetchpriority="high">
    </picture>
    <div class="banner-overlay-{{ banner_id }}"></div>
  {%- else -%}
    <div class="banner-placeholder-{{ banner_id }}">
      {{ 'hero-apparel-1' | placeholder_svg_tag }}
    </div>
  {%- endif -%}

  <div class="banner-content-{{ banner_id }}">

    {%- comment -%} Eyebrow icon / emoji {%- endcomment -%}
    {%- if section.settings.show_eyebrow_icon and section.settings.eyebrow_icon != blank -%}
      <span class="banner-eyebrow-{{ banner_id }}" aria-hidden="true">{{ section.settings.eyebrow_icon }}</span>
    {%- endif -%}

    {%- comment -%} Heading — with optional italic accent word {%- endcomment -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="banner-heading-{{ banner_id }}">
        {{- section.settings.heading -}}
        {%- if section.settings.heading_accent != blank -%}
          <em class="banner-heading-accent-{{ banner_id }}"> {{ section.settings.heading_accent }}</em>
        {%- endif -%}
      </h2>
    {%- endif -%}

    {%- comment -%} Three bullet/tagline lines {%- endcomment -%}
    {%- if section.settings.bullet_1 != blank or section.settings.bullet_2 != blank or section.settings.bullet_3 != blank -%}
      <div class="banner-bullets-{{ banner_id }}">
        {%- if section.settings.bullet_1 != blank -%}
          <p class="banner-bullet-{{ banner_id }}">{{ section.settings.bullet_1 }}</p>
        {%- endif -%}
        {%- if section.settings.bullet_2 != blank -%}
          <p class="banner-bullet-{{ banner_id }}">{{ section.settings.bullet_2 }}</p>
        {%- endif -%}
        {%- if section.settings.bullet_3 != blank -%}
          <p class="banner-bullet-{{ banner_id }}">{{ section.settings.bullet_3 }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Decorative divider {%- endcomment -%}
    {%- if section.settings.show_divider -%}
      <div class="banner-divider-{{ banner_id }}" aria-hidden="true">
        <span class="banner-divider-line-{{ banner_id }}"></span>
        <span class="banner-divider-icon-{{ banner_id }}">{{ section.settings.divider_icon }}</span>
        <span class="banner-divider-line-{{ banner_id }}"></span>
      </div>
    {%- endif -%}

    {%- comment -%} Tagline / secondary text {%- endcomment -%}
    {%- if section.settings.tagline != blank -%}
      <p class="banner-tagline-{{ banner_id }}">{{ section.settings.tagline }}</p>
    {%- endif -%}

    {%- comment -%} Legacy subheading {%- endcomment -%}
    {%- if section.settings.subheading != blank -%}
      <p class="banner-subheading-{{ banner_id }}">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- comment -%} Button {%- endcomment -%}
    {%- if section.settings.button_text != blank -%}
      <div class="banner-button-wrapper-{{ banner_id }}">
        <a href="{{ section.settings.button_link }}" class="banner-button-{{ banner_id }}">
          {{ section.settings.button_text }}
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "section_background_color",
      "label": "Section background colour",
      "default": "#FDEEF0",
      "info": "Used when no background image is set"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image (desktop)"
    },
    {
      "type": "image_picker",
      "id": "mobile_background_image",
      "label": "Background image (mobile)",
      "info": "Optional — uses desktop image if not set"
    },
    {
      "type": "range",
      "id": "banner_height",
      "min": 300,
      "max": 900,
      "step": 50,
      "unit": "px",
      "label": "Min height (no image)",
      "default": 500
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay colour",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 0
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "padding_top",
