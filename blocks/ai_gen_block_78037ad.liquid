{% doc %}
  @prompt
    Same as before, but with a separate option to add a mobile background image that appears only on smaller screens.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-arousique-wrapper-{{ ai_gen_id }} {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
  }

  .ai-hero-arousique-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    min-height: {{ block.settings.section_min_height }}px;
    background: linear-gradient(
      to right,
      {{ block.settings.gradient_color_left }},
      {{ block.settings.gradient_color_right }}
    );
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  {% if block.settings.background_image %}
    .ai-hero-arousique-{{ ai_gen_id }}::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image: url('{{ block.settings.background_image | image_url: width: 2000 }}');
      background-size: {{ block.settings.background_image_fit }};
      background-position: center;
      background-repeat: no-repeat;
      opacity: {{ block.settings.background_image_opacity | divided_by: 100.0 }};
      z-index: 0;
    }
  {% endif %}

  /* Mobile-specific background image */
  @media screen and (max-width: 768px) {
    {% if block.settings.background_image_mobile %}
      .ai-hero-arousique-{{ ai_gen_id }}::before {
        background-image: url('{{ block.settings.background_image_mobile | image_url: width: 1000 }}');
        background-size: {{ block.settings.background_image_fit }};
        background-position: center;
        background-repeat: no-repeat;
      }
    {% endif %}
  }

  .ai-hero-arousique-container-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    max-width: {{ block.settings.card_max_width }}px;
    width: 100%;
  }

  .ai-hero-arousique-card-{{ ai_gen_id }} {
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 100.0 }});
    text-align: center;
  }

  .ai-hero-arousique-card-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px;
    line-height: 1.2;
  }

  .ai-hero-arousique-card-statements-{{ ai_gen_id }} {
    font-size: {{ block.settings.statements_size }}px;
    color: {{ block.settings.statements_color }};
    line-height: 1.4;
    margin: 0 0 {{ block.settings.statements_margin_bottom }}px;
    font-weight: 500;
  }

  .ai-hero-arousique-card-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.5;
    margin: 0 0 {{ block.settings.description_margin_bottom }}px;
  }

  .ai-hero-arousique-card-button-{{ ai_gen_id }} {
    display: inline-block;
    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    border-radius: {{ block.settings.button_border_radius }}px;
    text-decoration: none;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .ai-hero-arousique-card-button-{{ ai_gen_id }}:hover {
    background: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
  }

  @media screen and (max-width: 768px) {
    .ai-hero-arousique-{{ ai_gen_id }} {
      min-height: auto;
      padding: 40px 15px;
    }

    .ai-hero-arousique-card-{{ ai_gen_id }} {
      padding: 25px 20px;
    }

    .ai-hero-arousique-card-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-hero-arousique-card-statements-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.statements_size }}px * 0.85);
    }

    .ai-hero-arousique-card-description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_size }}px * 0.9);
    }

    .ai-hero-arousique-card-button-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.button_font_size }}px * 0.9);
      padding: 10px 20px;
    }
  }
{% endstyle %}

<div class="ai-hero-arousique-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-arousique-container-{{ ai_gen_id }}">
    <div class="ai-hero-arousique-card-{{ ai_gen_id }}">
      {% if block.settings.card_heading != blank %}
        <h2 class="ai-hero-arousique-card-heading-{{ ai_gen_id }}">
          {{ block.settings.card_heading }}
        </h2>
      {% endif %}

      {% if block.settings.card_statements != blank %}
        <div class="ai-hero-arousique-card-statements-{{ ai_gen_id }}">
          {{ block.settings.card_statements }}
        </div>
      {% endif %}

      {% if block.settings.card_description != blank %}
        <div class="ai-hero-arousique-card-description-{{ ai_gen_id }}">
          {{ block.settings.card_description }}
        </div>
      {% endif %}

      {% if block.settings.button_text != blank %}
        <a
          href="{{ block.settings.button_link }}"
          class="ai-hero-arousique-card-button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

