{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-nav-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-category-nav-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-category-nav-list-{{ ai_gen_id }} {
    display: flex;
    justify-content: {{ block.settings.alignment }};
    align-items: flex-start;
    gap: {{ block.settings.spacing }}px;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ai-category-nav-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .ai-category-nav-link-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    transition: transform 0.3s ease;
  }

  .ai-category-nav-link-{{ ai_gen_id }}:hover {
    transform: {{ block.settings.hover_effect }};
  }

  /* =========================================
     3D GLOSSY ROUNDED ICON CONTAINER
     Force 50% border-radius to stay round
  ========================================= */
  .ai-category-nav-circle-{{ ai_gen_id }} {
    width: {{ block.settings.circle_size }}px;
    height: {{ block.settings.circle_size }}px;
    border-radius: 50% !important;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: {{ block.settings.label_spacing }}px;
    transition: box-shadow 0.3s ease, transform 0.3s ease;
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
    
    /* 3D Glossy Effect - Multiple shadows for depth */
    box-shadow: 
      0 12px 24px -8px rgba(0, 0, 0, 0.25),
      0 4px 8px -4px rgba(0, 0, 0, 0.15),
      inset 0 -2px 0 rgba(0, 0, 0, 0.1),
      inset 0 2px 4px rgba(255, 255, 255, 0.4);
  }

  /* Top glossy highlight overlay */
  .ai-category-nav-circle-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 50% !important;
    background: radial-gradient(
      ellipse at 30% 28%,
      rgba(255, 255, 255, 0.65) 0%,
      rgba(255, 255, 255, 0.2) 40%,
      transparent 80%
    );
    pointer-events: none;
    z-index: 1;
  }

  /* Bottom shadow that extends outside (for floating effect) */
  .ai-category-nav-circle-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 15%;
    width: 70%;
    height: 16px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.25);
    filter: blur(8px);
    pointer-events: none;
    z-index: -1;
    transition: opacity 0.3s ease, filter 0.3s ease;
  }

  /* Hover state - lift and enhance shadows */
  .ai-category-nav-link-{{ ai_gen_id }}:hover .ai-category-nav-circle-{{ ai_gen_id }} {
    box-shadow: 
      {{ block.settings.hover_shadow }},
      0 4px 8px -4px rgba(0, 0, 0, 0.2),
      inset 0 -2px 0 rgba(0, 0, 0, 0.08),
      inset 0 2px 4px rgba(255, 255, 255, 0.5);
    transform: translateY(-2px);
  }

  .ai-category-nav-link-{{ ai_gen_id }}:hover .ai-category-nav-circle-{{ ai_gen_id }}::after {
    opacity: 0.5;
    filter: blur(10px);
    transform: scale(1.05);
  }

  /* SVG icon inside circle - ensure crisp rendering */
  .ai-category-nav-circle-{{ ai_gen_id }} svg {
    width: 48%;
    height: 48%;
    flex-shrink: 0;
    display: block;
    position: relative;
    z-index: 2;
    filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.1));
  }

  /* Optional uploaded image (overrides SVG if set) */
  .ai-category-nav-icon-{{ ai_gen_id }} {
    object-fit: cover;
    position: absolute;
    inset: 6px;
    z-index: 2;
    border-radius: 50% !important;
  }

  .ai-category-nav-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    color: {{ block.settings.label_color }};
    font-weight: {{ block.settings.label_weight }};
    max-width: {{ block.settings.circle_size | plus: 20 }}px;
    word-wrap: break-word;
    line-height: 1.3;
    margin: 0;
    text-align: center;
  }

  /* Inner ring for premium 3D look */
  .ai-category-nav-circle-{{ ai_gen_id }} .inner-ring {
    position: absolute;
    top: 8%;
    left: 8%;
    width: 84%;
    height: 84%;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.25);
    pointer-events: none;
    z-index: 2;
  }

  @media screen and (max-width: 749px) {
    .ai-category-nav-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px 0 {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .ai-category-nav-container-{{ ai_gen_id }} {
      padding: 0 10px;
    }

    .ai-category-nav-list-{{ ai_gen_id }} {
      gap: {{ block.settings.spacing | times: 0.6 }}px;
      flex-wrap: nowrap;
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      justify-content: flex-start;
      padding-bottom: 4px;
    }

    .ai-category-nav-list-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ai-category-nav-item-{{ ai_gen_id }} {
      flex-shrink: 0;
    }

    .ai-category-nav-circle-{{ ai_gen_id }} {
      width: {{ block.settings.circle_size | times: 0.7 }}px;
      height: {{ block.settings.circle_size | times: 0.7 }}px;
      margin-bottom: {{ block.settings.label_spacing | times: 0.7 }}px;
    }

    .ai-category-nav-label-{{ ai_gen_id }} {
      font-size: {{ block.settings.label_size | times: 0.85 }}px;
      max-width: {{ block.settings.circle_size | times: 0.7 | plus: 10 }}px;
    }
  }
{% endstyle %}

