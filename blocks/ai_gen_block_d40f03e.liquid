<div class="ai-category-nav-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-category-nav-container-{{ ai_gen_id }}">
    <ul class="ai-category-nav-list-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% assign label_key      = 'category_' | append: i | append: '_label' %}
        {% assign icon_key       = 'category_' | append: i | append: '_icon' %}
        {% assign icon_type_key  = 'category_' | append: i | append: '_icon_type' %}
        {% assign icon_color_key = 'category_' | append: i | append: '_icon_color' %}
        {% assign circle_bg_key  = 'category_' | append: i | append: '_circle_bg' %}
        {% assign collection_key = 'category_' | append: i | append: '_collection' %}
        {% assign link_key       = 'category_' | append: i | append: '_link' %}
        {% assign alt_key        = 'category_' | append: i | append: '_alt' %}

        {% assign category_label      = block.settings[label_key] %}
        {% assign category_icon       = block.settings[icon_key] %}
        {% assign category_icon_type  = block.settings[icon_type_key] %}
        {% assign category_icon_color = block.settings[icon_color_key] %}
        {% assign category_circle_bg  = block.settings[circle_bg_key] %}
        {% assign category_collection = block.settings[collection_key] %}
        {% assign category_link       = block.settings[link_key] %}
        {% assign category_alt        = block.settings[alt_key] %}

        {% assign category_url = '' %}
        {% if category_collection != blank %}
          {% assign category_url = collections[category_collection].url %}
        {% elsif category_link != blank %}
          {% assign category_url = category_link %}
        {% endif %}

        {% if category_label != blank or category_icon %}
          <li class="ai-category-nav-item-{{ ai_gen_id }}">
            <a
              href="{{ category_url }}"
              class="ai-category-nav-link-{{ ai_gen_id }}"
              {% if category_url == blank %}aria-disabled="true"{% endif %}
            >
              <div
                class="ai-category-nav-circle-{{ ai_gen_id }}"
                style="background: {{ category_circle_bg | default: block.settings.circle_background }}; color: {{ category_icon_color | default: block.settings.icon_color }};"
              >
                <div class="inner-ring"></div>
                {% if category_icon != blank %}
                  {% comment %} Uploaded image takes priority over SVG icon {% endcomment %}
                  <img
                    src="{{ category_icon | image_url: width: 200 }}"
                    alt="{{ category_alt | escape }}"
                    class="ai-category-nav-icon-{{ ai_gen_id }}"
                    loading="lazy"
                    width="200"
                    height="200"
                  >
                {% else %}
                  {% comment %} Render SVG icon by type {% endcomment %}
                  {% case category_icon_type %}
                    {% when 'couples'  %}{{ svg_couples }}
                    {% when 'for_her'  %}{{ svg_for_her }}
                    {% when 'for_him'  %}{{ svg_for_him }}
                    {% when 'gift'     %}{{ svg_gift }}
                    {% when 'learn'    %}{{ svg_learn }}
                    {% when 'wellness' %}{{ svg_wellness }}
                    {% when 'massage'  %}{{ svg_massage }}
                    {% when 'intimate' %}{{ svg_intimate }}
                    {% when 'bundle'   %}{{ svg_bundle }}
                    {% when 'new'      %}{{ svg_new }}
                    {% when 'sale'     %}{{ svg_sale }}
                    {% when 'discreet' %}{{ svg_discreet }}
                    {% else %}{{ svg_wellness }}
                  {% endcase %}
                {% endif %}
              </div>

              {% if category_label != blank %}
                <span class="ai-category-nav-label-{{ ai_gen_id }}">{{ category_label }}</span>
              {% endif %}
            </a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</div>

