    <div class="ai-footer-main-{{ ai_gen_id }}">
      <div class="ai-footer-column-{{ ai_gen_id }}">
        <div class="ai-footer-brand-{{ ai_gen_id }}">
          <img class="brand-img" src="{{ block.settings.brand-img | img_url: '1800x1800' }}" alt="{{ block.settings.brand_name }}" loading="lazy">
        </div>
        <div class="ai-footer-tagline-{{ ai_gen_id }}">{{ block.settings.tagline }}</div>
        <div class="ai-footer-description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
        <div class="ai-footer-social-{{ ai_gen_id }}">
          {% if block.settings.instagram_url != blank %}
            <a
              href="{{ block.settings.instagram_url }}"
              class="ai-footer-social-link-{{ ai_gen_id }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
            >
