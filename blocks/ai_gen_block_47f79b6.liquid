              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
          {% endif %}
          {% if block.settings.facebook_url != blank %}
            <a
              href="{{ block.settings.facebook_url }}"
              class="ai-footer-social-link-{{ ai_gen_id }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
            >
              <!-- Facebook — clean modern 'f' path -->
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
          {% endif %}
          {% if block.settings.youtube_url != blank %}
            <a
              href="{{ block.settings.youtube_url }}"
              class="ai-footer-social-link-{{ ai_gen_id }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="YouTube"
            >
              <!-- YouTube — modern play-button mark -->
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>
          {% endif %}
          {% if block.settings.tiktok_url != blank %}
            <a
              href="{{ block.settings.tiktok_url }}"
              class="ai-footer-social-link-{{ ai_gen_id }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="TikTok"
            >
              <!-- TikTok — official mark path -->
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.75a4.85 4.85 0 0 1-1.01-.06z"/>
              </svg>
            </a>
          {% endif %}
        </div>
      </div>

      <div class="ai-footer-column-{{ ai_gen_id }}">
        <h3 class="ai-footer-heading-{{ ai_gen_id }}">{{ block.settings.links_heading }}</h3>
        <div class="ai-footer-links-grid-{{ ai_gen_id }}">
          {% if block.settings.link_1_text != blank %}
            <a href="{{ block.settings.link_1_url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.link_1_text }}</a>
          {% endif %}
          {% if block.settings.link_2_text != blank %}
            <a href="{{ block.settings.link_2_url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.link_2_text }}</a>
          {% endif %}
          {% if block.settings.link_3_text != blank %}
            <a href="{{ block.settings.link_3_url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.link_3_text }}</a>
          {% endif %}
          {% if block.settings.link_4_text != blank %}
            <a href="{{ block.settings.link_4_url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.link_4_text }}</a>
          {% endif %}
          {% if block.settings.link_5_text != blank %}
            <a href="{{ block.settings.link_5_url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.link_5_text }}</a>
          {% endif %}
          {% if block.settings.link_6_text != blank %}
            <a href="{{ block.settings.link_6_url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.link_6_text }}</a>
          {% endif %}
          {% if block.settings.link_7_text != blank %}
            <a href="{{ block.settings.link_7_url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.link_7_text }}</a>
          {% endif %}
          {% if block.settings.link_8_text != blank %}
            <a href="{{ block.settings.link_8_url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.link_8_text }}</a>
          {% endif %}
          {% if block.settings.link_9_text != blank %}
            <a href="{{ block.settings.link_9_url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.link_9_text }}</a>
          {% endif %}
          {% if block.settings.link_10_text != blank %}
            <a href="{{ block.settings.link_10_url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.link_10_text }}</a>
          {% endif %}
          {% if block.settings.link_11_text != blank %}
            <a href="{{ block.settings.link_11_url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.link_11_text }}</a>
          {% endif %}
        </div>
      </div>

      <div class="ai-footer-column-{{ ai_gen_id }}">
        <h3 class="ai-footer-heading-{{ ai_gen_id }}">{{ block.settings.newsletter_heading }}</h3>
        <div class="ai-footer-newsletter-{{ ai_gen_id }}">
          <div class="ai-footer-newsletter-text-{{ ai_gen_id }}">
            {{ block.settings.newsletter_text }}
          </div>
          {%- form 'contact' -%}
            <input
              type="hidden"
              name="contact[tags]"
              value="newsletter"
            >
            <input
              type="email"
              name="contact[email]"
              class="ai-footer-newsletter-input-{{ ai_gen_id }}"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="ai-footer-newsletter-error-{{ ai_gen_id }}"
              {% endif %}
              {% if form.posted_successfully? %}
                aria-describedby="ai-footer-newsletter-success-{{ ai_gen_id }}"
              {% endif %}
              placeholder="{{ block.settings.email_placeholder }}"
              required
            >
            <button
              type="submit"
              class="ai-footer-newsletter-button-{{ ai_gen_id }}"
            >
              {{ block.settings.button_text }}
            </button>
            {%- if form.errors -%}
              <div id="ai-footer-newsletter-error-{{ ai_gen_id }}" class="ai-footer-error-{{ ai_gen_id }}">
                <span>{{ form.errors.messages.email }}</span>
              </div>
            {%- endif -%}
            {%- if form.posted_successfully? -%}
              <div id="ai-footer-newsletter-success-{{ ai_gen_id }}" class="ai-footer-success-{{ ai_gen_id }}">
                <span>{{ block.settings.success_message }}</span>
              </div>
            {%- endif -%}
          {%- endform -%}
        </div>
      </div>
    </div>

    <div class="ai-footer-policy-links-{{ ai_gen_id }}">
      {% if block.settings.privacy_url != blank %}
        <a href="{{ block.settings.privacy_url }}" class="ai-footer-policy-link-{{ ai_gen_id }}">Privacy Policy</a>
      {% endif %}
      {% if block.settings.terms_url != blank %}
        <a href="{{ block.settings.terms_url }}" class="ai-footer-policy-link-{{ ai_gen_id }}">Terms of Use</a>
      {% endif %}
    </div>
  </div>

  <div class="ai-footer-bottom-{{ ai_gen_id }}">
    <div class="ai-footer-copyright-{{ ai_gen_id }}">
      {{ block.settings.copyright_text }}
    </div>
  </div>
</footer>

