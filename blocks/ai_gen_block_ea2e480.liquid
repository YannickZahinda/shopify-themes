{% doc %}
  Trust / Promise section — Arousique brand
  Fixed: icon fit (contain + padding), brand colors, reduced white space
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  /* ── Section ── */
  .ai-trust-section-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }} !important;
    background: {{ block.settings.background_color }} !important;
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
    width: 100vw;
    position: relative;
  }

  /* Subtle top/bottom border lines to frame the section */
  .ai-trust-section-{{ ai_gen_id }}::before,
  .ai-trust-section-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(212,175,55,0.6), transparent);
  }
  .ai-trust-section-{{ ai_gen_id }}::before { top: 0; }
  .ai-trust-section-{{ ai_gen_id }}::after  { bottom: 0; }

  .ai-trust-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* ── Header ── */
  .ai-trust-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.spacing_below_header }}px;
  }

  .ai-trust-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }} !important;
    margin: 0 0 {{ block.settings.spacing_between_headings }}px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .ai-trust-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }} !important;
    margin: 0;
    font-weight: 400;
    line-height: 1.5;
  }

  /* ── Gold accent under heading ── */
  .ai-trust-accent-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 14px auto 0;
  }
  .ai-trust-accent-{{ ai_gen_id }} span {
    display: block;
    height: 1px;
    width: 40px;
    background: linear-gradient(90deg, transparent, #D4AF37);
  }
  .ai-trust-accent-{{ ai_gen_id }} span:last-child {
    background: linear-gradient(90deg, #D4AF37, transparent);
  }
  .ai-trust-accent-dot-{{ ai_gen_id }} {
    width: 5px !important;
    height: 5px !important;
    border-radius: 50%;
    background: #D4AF37 !important;
    flex-shrink: 0;
  }

  /* ── Grid ── */
  .ai-trust-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  /* ── Feature item ── */
  .ai-trust-feature-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: {{ block.settings.spacing_below_icon }}px;
  }

  /* ── Circle wrapper ── */
  .ai-trust-icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.circle_size }}px;
    height: {{ block.settings.circle_size }}px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    position: relative;
    /* Inner padding so icon never bleeds to the circle edge */
    padding: {{ block.settings.icon_padding }}px;
    box-sizing: border-box;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    /* Soft shadow to lift circles off the background */
    box-shadow: 0 4px 16px rgba(0,0,0,0.12);
  }

  {% if block.settings.enable_hover_effect %}
    .ai-trust-feature-{{ ai_gen_id }}:hover .ai-trust-icon-wrapper-{{ ai_gen_id }} {
      transform: scale(1.08) translateY(-3px);
      box-shadow: 0 10px 28px rgba(0,0,0,0.18);
    }
  {% endif %}

  /* ── Icon image ── */
  .ai-trust-icon-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    /* Clip the image into a circle — removes the white square background */
    border-radius: 50%;
    /* No blend mode — full natural colors */
  }

  /* ── Placeholder (no image uploaded) ── */
  .ai-trust-icon-placeholder-{{ ai_gen_id }} {
    width: 60%;
    height: 60%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.5;
  }
  .ai-trust-icon-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  /* ── Label ── */
  .ai-trust-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    color: {{ block.settings.label_color }} !important;
    font-weight: {{ block.settings.label_weight }};
    margin: 0;
    line-height: 1.3;
    max-width: {{ block.settings.circle_size | plus: 20 }}px;
  }

  /* ── Tablet ── */
  @media screen and (max-width: 989px) {
    .ai-trust-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
    .ai-trust-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
    .ai-trust-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.9 }}px;
    }
  }

  /* ── Mobile ── */
  @media screen and (max-width: 749px) {
    .ai-trust-section-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 }}px 16px {{ block.settings.padding_bottom | times: 0.7 }}px;
    }
    .ai-trust-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.grid_gap | times: 0.75 }}px;
    }
    .ai-trust-icon-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.circle_size | times: 0.82 }}px;
      height: {{ block.settings.circle_size | times: 0.82 }}px;
    }
    .ai-trust-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.62 }}px;
    }
    .ai-trust-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.85 }}px;
    }
    .ai-trust-label-{{ ai_gen_id }} {
      font-size: {{ block.settings.label_size | times: 0.88 }}px;
    }
  }
{% endstyle %}

<div class="ai-trust-section-{{ ai_gen_id }}" style="background-color: {{ block.settings.background_color }} !important; background: {{ block.settings.background_color }} !important;" {{ block.shopify_attributes }}>
  <div class="ai-trust-container-{{ ai_gen_id }}">

    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-trust-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-trust-heading-{{ ai_gen_id }}" style="color: {{ block.settings.heading_color }} !important;">{{ block.settings.heading }}</h2>
        {% endif %}

        <!-- Gold accent line under heading -->
        <div class="ai-trust-accent-{{ ai_gen_id }}">
          <span></span>
          <span class="ai-trust-accent-dot-{{ ai_gen_id }}"></span>
          <span></span>
        </div>

        {% if block.settings.subheading != blank %}
          <p class="ai-trust-subheading-{{ ai_gen_id }}" style="margin-top: 12px; color: {{ block.settings.subheading_color }} !important;">
            {{ block.settings.subheading }}
          </p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-trust-grid-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign feat_enabled_key   = 'feature_' | append: i | append: '_enabled'
          assign feat_icon_key      = 'feature_' | append: i | append: '_icon'
          assign feat_label_key     = 'feature_' | append: i | append: '_label'
          assign feat_color_key     = 'feature_' | append: i | append: '_color'
          assign feat_icon_color_key = 'feature_' | append: i | append: '_icon_color'

          assign feat_enabled    = block.settings[feat_enabled_key]
          assign feat_icon       = block.settings[feat_icon_key]
          assign feat_label      = block.settings[feat_label_key]
          assign feat_color      = block.settings[feat_color_key]
          assign feat_icon_color = block.settings[feat_icon_color_key]
        %}

        {% if feat_enabled %}
          <div class="ai-trust-feature-{{ ai_gen_id }}">
            <div
              class="ai-trust-icon-wrapper-{{ ai_gen_id }}"
              style="background-color: {{ feat_color }};"
            >
              {% if feat_icon != blank %}
                <img
                  src="{{ feat_icon | image_url: width: 300 }}"
                  alt="{{ feat_label | escape }}"
                  class="ai-trust-icon-{{ ai_gen_id }}"
                  loading="lazy"
                  width="300"
                  height="300"
                >
              {% else %}
                <div
                  class="ai-trust-icon-placeholder-{{ ai_gen_id }}"
                  style="color: {{ feat_icon_color }};"
                >
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            {% if feat_label != blank %}
              <p class="ai-trust-label-{{ ai_gen_id }}" style="color: {{ block.settings.label_color }} !important;">{{ feat_label }}</p>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</div>

