{% comment %}
  AROUSIQUE PREMIUM CONTACT FORM
  Elegant design with split layout, smooth animations, and responsive design
{% endcomment %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  :root {
    --contact-luxury-gold: #D4AF37;
    --contact-luxury-burgundy: #7B1E3A;
    --contact-luxury-dark: #1F1117;
    --contact-luxury-cream: #FFF8F4;
    --contact-luxury-pink: #F9B8D4;
    --contact-luxury-rose: #E75480;
  }

  .ai-contact-section-{{ ai_gen_id }} {
    position: relative;
    background: {{ block.settings.bg_gradient_start }}; /* fallback */
    background: {{ block.settings.bg_gradient }};
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_sides }}px {{ block.settings.padding_bottom }}px;
    overflow: hidden;
    width: 100%;
    display: block;
    box-sizing: border-box;
  }

  /* Premium Background Pattern Overlay */
  .ai-contact-section-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" opacity="0.03"><path fill="none" stroke="%23D4AF37" stroke-width="0.5" d="M10 10 L90 10 M10 20 L90 20 M10 30 L90 30 M10 40 L90 40 M10 50 L90 50 M10 60 L90 60 M10 70 L90 70 M10 80 L90 80 M10 90 L90 90 M10 10 L10 90 M20 10 L20 90 M30 10 L30 90 M40 10 L40 90 M50 10 L50 90 M60 10 L60 90 M70 10 L70 90 M80 10 L80 90 M90 10 L90 90"/><circle cx="50" cy="50" r="2" fill="%23D4AF37"/></svg>');
    background-repeat: repeat;
    pointer-events: none;
  }

  .ai-contact-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  /* Title Section */
  .ai-contact-title-wrapper-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.title_bottom_margin }}px;
  }

  .ai-contact-badge-{{ ai_gen_id }} {
    display: inline-block;
    font-size: {{ block.settings.badge_size }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: {{ block.settings.badge_color }};
    background: {{ block.settings.badge_bg }};
    padding: 6px 20px;
    border-radius: 50px;
    margin-bottom: 20px;
    font-family: 'Tomato Grotesk', sans-serif;
  }

  .ai-contact-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    margin: 0 0 20px;
    line-height: 1.2;
    font-family: 'Tomato Grotesk', sans-serif;
    letter-spacing: -0.02em;
  }

  .ai-contact-subtitle-{{ ai_gen_id }} {
    color: {{ block.settings.subtitle_color }};
    font-size: {{ block.settings.subtitle_size }}px;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
    font-family: 'Myriad Pro', sans-serif;
  }

  /* Split Layout */
  .ai-contact-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.grid_gap }}px;
    background: {{ block.settings.form_bg }};
    border-radius: {{ block.settings.container_radius }}px;
    overflow: hidden;
    box-shadow: {{ block.settings.container_shadow }};
  }

  /* Left Side - Contact Info */
  .ai-contact-info-{{ ai_gen_id }} {
    background: {{ block.settings.info_bg }};
    padding: {{ block.settings.info_padding }}px;
    position: relative;
    overflow: hidden;
  }

  .ai-contact-info-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    top: -50%;
    right: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, {{ block.settings.info_accent_color }} 0%, transparent 70%);
    opacity: 0.08;
    pointer-events: none;
  }

  .ai-info-header-{{ ai_gen_id }} {
    margin-bottom: 40px;
  }

  .ai-info-title-{{ ai_gen_id }} {
    color: {{ block.settings.info_title_color }};
    font-size: {{ block.settings.info_title_size }}px;
    font-weight: 600;
    margin: 0 0 15px;
    font-family: 'Tomato Grotesk', sans-serif;
  }

  .ai-info-text-{{ ai_gen_id }} {
    color: {{ block.settings.info_text_color }};
    font-size: {{ block.settings.info_text_size }}px;
    line-height: 1.6;
    margin: 0;
    font-family: 'Myriad Pro', sans-serif;
  }

  /* Contact Methods */
  .ai-contact-methods-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 30px;
    margin-bottom: 40px;
  }

  .ai-method-item-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 15px;
    transition: transform 0.3s ease;
  }

  .ai-method-item-{{ ai_gen_id }}:hover {
    transform: translateX(5px);
  }

  .ai-method-icon-{{ ai_gen_id }} {
    width: 50px;
    height: 50px;
    background: {{ block.settings.icon_bg }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    color: {{ block.settings.icon_color }};
    flex-shrink: 0;
    transition: all 0.3s ease;
  }

  .ai-method-item-{{ ai_gen_id }}:hover .ai-method-icon-{{ ai_gen_id }} {
    transform: scale(1.1);
    background: {{ block.settings.icon_hover_bg }};
    color: {{ block.settings.icon_hover_color }};
  }

  .ai-method-content-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-method-title-{{ ai_gen_id }} {
    color: {{ block.settings.method_title_color }};
    font-size: {{ block.settings.method_title_size }}px;
    font-weight: 600;
    margin: 0 0 5px;
    font-family: 'Tomato Grotesk', sans-serif;
  }

  .ai-method-detail-{{ ai_gen_id }} {
    color: {{ block.settings.method_detail_color }};
    font-size: {{ block.settings.method_detail_size }}px;
    margin: 0;
    font-family: 'Myriad Pro', sans-serif;
  }

  .ai-method-detail-{{ ai_gen_id }} a {
    color: inherit;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .ai-method-detail-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
  }

  /* Social Links */
  .ai-social-links-{{ ai_gen_id }} {
    margin-top: 40px;
  }

  .ai-social-title-{{ ai_gen_id }} {
    color: {{ block.settings.social_title_color }};
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 15px;
    font-family: 'Tomato Grotesk', sans-serif;
  }

  .ai-social-icons-{{ ai_gen_id }} {
    display: flex;
    gap: 15px;
  }

  .ai-social-icon-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    background: {{ block.settings.social_icon_bg }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.social_icon_color }};
    text-decoration: none;
    font-size: 18px;
    transition: all 0.3s ease;
  }

  .ai-social-icon-{{ ai_gen_id }}:hover {
    background: {{ block.settings.social_icon_hover_bg }};
    color: {{ block.settings.social_icon_hover_color }};
    transform: translateY(-3px);
  }

  /* Right Side - Form */
  .ai-contact-form-{{ ai_gen_id }} {
    padding: {{ block.settings.form_padding }}px;
    background: {{ block.settings.form_bg }};
  }

  .ai-form-group-{{ ai_gen_id }} {
    margin-bottom: 25px;
  }

  .ai-form-label-{{ ai_gen_id }} {
    display: block;
    color: {{ block.settings.label_color }};
    font-size: {{ block.settings.label_size }}px;
    font-weight: 500;
    margin-bottom: 8px;
    font-family: 'Tomato Grotesk', sans-serif;
  }

  .ai-form-label-{{ ai_gen_id }} .required {
    color: {{ block.settings.required_color }};
    margin-left: 4px;
  }

  .ai-form-input-{{ ai_gen_id }},
  .ai-form-textarea-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.input_padding }}px;
    border: {{ block.settings.input_border_width }}px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_radius }}px;
    font-size: {{ block.settings.input_text_size }}px;
    font-family: 'Myriad Pro', sans-serif;
    background: {{ block.settings.input_bg }};
    color: {{ block.settings.input_text_color }};
    transition: all 0.3s ease;
  }

  .ai-form-input-{{ ai_gen_id }}:focus,
  .ai-form-textarea-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.input_focus_border }};
    box-shadow: 0 0 0 3px {{ block.settings.input_focus_border }}20;
  }

  .ai-form-textarea-{{ ai_gen_id }} {
    resize: vertical;
    min-height: 120px;
  }

  /* Submit Button */
  .ai-submit-btn-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.btn_padding }}px;
    background: {{ block.settings.btn_bg }};
    color: {{ block.settings.btn_text_color }};
    border: none;
    border-radius: {{ block.settings.btn_radius }}px;
    font-size: {{ block.settings.btn_text_size }}px;
    font-weight: 600;
    font-family: 'Tomato Grotesk', sans-serif;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .ai-submit-btn-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    transform: translate(-50%, -50%);
    transition: width 0.6s, height 0.6s;
  }

  .ai-submit-btn-{{ ai_gen_id }}:hover::before {
    width: 300px;
    height: 300px;
  }

  .ai-submit-btn-{{ ai_gen_id }}:hover {
    background: {{ block.settings.btn_hover_bg }};
    transform: translateY(-2px);
    box-shadow: {{ block.settings.btn_shadow }};
  }

  .ai-submit-btn-{{ ai_gen_id }}:active {
    transform: translateY(0);
  }

  /* Success Message */
  .ai-success-message-{{ ai_gen_id }} {
    display: none;
    background: {{ block.settings.success_bg }};
    color: {{ block.settings.success_color }};
    padding: 15px 20px;
    border-radius: {{ block.settings.input_radius }}px;
    margin-top: 20px;
    text-align: center;
    font-family: 'Myriad Pro', sans-serif;
    animation: slideUp 0.5s ease;
  }

  .ai-success-message-{{ ai_gen_id }}.show {
    display: block;
  }

  /* Error Message */
  .ai-error-message-{{ ai_gen_id }} {
    display: none;
    background: {{ block.settings.error_bg }};
    color: {{ block.settings.error_color }};
    padding: 12px 20px;
    border-radius: {{ block.settings.input_radius }}px;
    margin-bottom: 20px;
    font-family: 'Myriad Pro', sans-serif;
    font-size: 14px;
  }

  .ai-error-message-{{ ai_gen_id }}.show {
    display: block;
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Loading Animation */
  .ai-submit-btn-{{ ai_gen_id }}.loading {
    position: relative;
    color: transparent;
  }

  .ai-submit-btn-{{ ai_gen_id }}.loading::after {
    content: '';
    position: absolute;
    width: 20px;
    height: 20px;
    top: 50%;
    left: 50%;
    margin-left: -10px;
    margin-top: -10px;
    border: 2px solid {{ block.settings.btn_text_color }};
    border-top-color: transparent;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Responsive — tablet */
  @media screen and (max-width: 1024px) {
    .ai-contact-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr 1fr;
    }

    .ai-contact-info-{{ ai_gen_id }} {
      padding: {{ block.settings.info_padding | times: 0.75 | round }}px;
    }

    .ai-contact-form-{{ ai_gen_id }} {
      padding: {{ block.settings.form_padding | times: 0.75 | round }}px;
    }
  }

  /* Responsive — stack panels below 860px */
  @media screen and (max-width: 860px) {
    .ai-contact-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .ai-contact-info-{{ ai_gen_id }} {
      padding: 40px 32px;
    }

    .ai-contact-form-{{ ai_gen_id }} {
      padding: 40px 32px;
    }

    .ai-contact-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.78 | round }}px;
    }

    .ai-contact-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.88 | round }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-contact-section-{{ ai_gen_id }} {
      padding: 40px 0 0;
    }

    .ai-contact-container-{{ ai_gen_id }} {
      padding: 0;
    }

    .ai-contact-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 | round }}px;
    }

    .ai-contact-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.85 | round }}px;
    }

    .ai-info-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.info_title_size | times: 0.88 | round }}px;
    }

    .ai-method-icon-{{ ai_gen_id }} {
      width: 42px;
      height: 42px;
      font-size: 20px;
    }

    .ai-method-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.method_title_size | times: 0.88 | round }}px;
    }

    .ai-contact-grid-{{ ai_gen_id }} {
      border-radius: 0;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-contact-info-{{ ai_gen_id }} {
      padding: 32px 20px;
    }

    .ai-contact-form-{{ ai_gen_id }} {
      padding: 32px 20px;
    }

    .ai-contact-methods-{{ ai_gen_id }} {
      gap: 20px;
    }

    .ai-method-item-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .ai-social-icons-{{ ai_gen_id }} {
      justify-content: center;
    }

    .ai-contact-title-wrapper-{{ ai_gen_id }} {
      padding: 0 16px;
    }
  }
{% endstyle %}

<div class="ai-contact-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-contact-container-{{ ai_gen_id }}">
    <!-- Header -->
    <div class="ai-contact-title-wrapper-{{ ai_gen_id }}">
      {% if block.settings.badge_text != blank %}
        <div class="ai-contact-badge-{{ ai_gen_id }}">{{ block.settings.badge_text }}</div>
      {% endif %}
      {% if block.settings.title != blank %}
        <h2 class="ai-contact-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}
      {% if block.settings.subtitle != blank %}
        <p class="ai-contact-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
      {% endif %}
    </div>

    <!-- Split Grid -->
    <div class="ai-contact-grid-{{ ai_gen_id }}">
      <!-- Left Side - Info -->
      <div class="ai-contact-info-{{ ai_gen_id }}">
        <div class="ai-info-header-{{ ai_gen_id }}">
          <h3 class="ai-info-title-{{ ai_gen_id }}">{{ block.settings.info_title }}</h3>
          <p class="ai-info-text-{{ ai_gen_id }}">{{ block.settings.info_text }}</p>
        </div>

        <div class="ai-contact-methods-{{ ai_gen_id }}">
          <!-- Email -->
          <div class="ai-method-item-{{ ai_gen_id }}">
            <div class="ai-method-icon-{{ ai_gen_id }}">✉️</div>
            <div class="ai-method-content-{{ ai_gen_id }}">
              <h4 class="ai-method-title-{{ ai_gen_id }}">Email Us</h4>
              <p class="ai-method-detail-{{ ai_gen_id }}">
                <a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a>
              </p>
              <p class="ai-method-detail-{{ ai_gen_id }}" style="font-size: 13px; opacity: 0.7;">Reply within 24 hours</p>
            </div>
          </div>

          <!-- Phone -->
          <div class="ai-method-item-{{ ai_gen_id }}">
            <div class="ai-method-icon-{{ ai_gen_id }}">📞</div>
            <div class="ai-method-content-{{ ai_gen_id }}">
              <h4 class="ai-method-title-{{ ai_gen_id }}">Call Us</h4>
              <p class="ai-method-detail-{{ ai_gen_id }}">
                <a href="tel:{{ block.settings.phone }}">{{ block.settings.phone }}</a>
              </p>
              <p class="ai-method-detail-{{ ai_gen_id }}" style="font-size: 13px; opacity: 0.7;">Mon-Fri, 10am - 7pm</p>
            </div>
          </div>

          <!-- Location -->
          <div class="ai-method-item-{{ ai_gen_id }}">
            <div class="ai-method-icon-{{ ai_gen_id }}">📍</div>
            <div class="ai-method-content-{{ ai_gen_id }}">
              <h4 class="ai-method-title-{{ ai_gen_id }}">Visit Us</h4>
              <p class="ai-method-detail-{{ ai_gen_id }}">{{ block.settings.address }}</p>
            </div>
          </div>

          <!-- WhatsApp -->
          {% if block.settings.whatsapp != blank %}
          <div class="ai-method-item-{{ ai_gen_id }}">
            <div class="ai-method-icon-{{ ai_gen_id }}">💬</div>
            <div class="ai-method-content-{{ ai_gen_id }}">
              <h4 class="ai-method-title-{{ ai_gen_id }}">WhatsApp</h4>
              <p class="ai-method-detail-{{ ai_gen_id }}">
                <a href="https://wa.me/{{ block.settings.whatsapp | remove: '+' | remove: ' ' }}">{{ block.settings.whatsapp }}</a>
              </p>
            </div>
          </div>
          {% endif %}
        </div>

        <!-- Social Links -->
        <div class="ai-social-links-{{ ai_gen_id }}">
          <h4 class="ai-social-title-{{ ai_gen_id }}">Follow Us</h4>
          <div class="ai-social-icons-{{ ai_gen_id }}">
            {% if block.settings.instagram != blank %}
              <a href="{{ block.settings.instagram }}" class="ai-social-icon-{{ ai_gen_id }}" target="_blank" rel="noopener noreferrer">
                📷
              </a>
            {% endif %}
            {% if block.settings.facebook != blank %}
              <a href="{{ block.settings.facebook }}" class="ai-social-icon-{{ ai_gen_id }}" target="_blank" rel="noopener noreferrer">
                👍
              </a>
            {% endif %}
            {% if block.settings.twitter != blank %}
              <a href="{{ block.settings.twitter }}" class="ai-social-icon-{{ ai_gen_id }}" target="_blank" rel="noopener noreferrer">
                🐦
              </a>
            {% endif %}
          </div>
        </div>
      </div>

      <!-- Right Side - Form -->
      <div class="ai-contact-form-{{ ai_gen_id }}">
        <div id="ai-error-message-{{ ai_gen_id }}" class="ai-error-message-{{ ai_gen_id }}"></div>
        
        <form id="ai-contact-form-{{ ai_gen_id }}" method="POST" action="{{ block.settings.form_action | default: '#' }}">
          <div class="ai-form-group-{{ ai_gen_id }}">
            <label class="ai-form-label-{{ ai_gen_id }}" for="name-{{ ai_gen_id }}">
              Full Name <span class="required">*</span>
            </label>
            <input 
              type="text" 
              id="name-{{ ai_gen_id }}" 
              name="name" 
              class="ai-form-input-{{ ai_gen_id }}"
              placeholder="Enter your full name"
              required
            >
          </div>

          <div class="ai-form-group-{{ ai_gen_id }}">
            <label class="ai-form-label-{{ ai_gen_id }}" for="email-{{ ai_gen_id }}">
              Email Address <span class="required">*</span>
            </label>
            <input 
              type="email" 
              id="email-{{ ai_gen_id }}" 
              name="email" 
              class="ai-form-input-{{ ai_gen_id }}"
              placeholder="your@email.com"
              required
            >
          </div>

          <div class="ai-form-group-{{ ai_gen_id }}">
            <label class="ai-form-label-{{ ai_gen_id }}" for="phone-{{ ai_gen_id }}">
              Phone Number
            </label>
            <input 
              type="tel" 
              id="phone-{{ ai_gen_id }}" 
              name="phone" 
              class="ai-form-input-{{ ai_gen_id }}"
              placeholder="Your phone number (optional)"
            >
          </div>

          <div class="ai-form-group-{{ ai_gen_id }}">
            <label class="ai-form-label-{{ ai_gen_id }}" for="subject-{{ ai_gen_id }}">
              Subject <span class="required">*</span>
            </label>
            <select id="subject-{{ ai_gen_id }}" name="subject" class="ai-form-input-{{ ai_gen_id }}" required>
              <option value="">Select a subject</option>
              <option value="general">General Inquiry</option>
              <option value="order">Order Support</option>
              <option value="returns">Returns & Exchange</option>
              <option value="wholesale">Wholesale Inquiry</option>
              <option value="collaboration">Collaboration</option>
            </select>
          </div>

          <div class="ai-form-group-{{ ai_gen_id }}">
            <label class="ai-form-label-{{ ai_gen_id }}" for="message-{{ ai_gen_id }}">
              Your Message <span class="required">*</span>
            </label>
            <textarea 
              id="message-{{ ai_gen_id }}" 
              name="message" 
              class="ai-form-textarea-{{ ai_gen_id }}"
              placeholder="How can we help you?"
              required
            ></textarea>
          </div>

          <button type="submit" class="ai-submit-btn-{{ ai_gen_id }}" id="ai-submit-btn-{{ ai_gen_id }}">
            Send Message →
          </button>

          <div id="ai-success-message-{{ ai_gen_id }}" class="ai-success-message-{{ ai_gen_id }}">
            ✨ Thank you for reaching out! We'll get back to you within 24 hours. ✨
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    const form = document.getElementById('ai-contact-form-{{ ai_gen_id }}');
    const submitBtn = document.getElementById('ai-submit-btn-{{ ai_gen_id }}');
    const successMsg = document.getElementById('ai-success-message-{{ ai_gen_id }}');
    const errorMsg = document.getElementById('ai-error-message-{{ ai_gen_id }}');

    if (form) {
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        // Clear previous messages
        errorMsg.classList.remove('show');
        successMsg.classList.remove('show');
        
        // Validate form
        const name = document.getElementById('name-{{ ai_gen_id }}').value.trim();
        const email = document.getElementById('email-{{ ai_gen_id }}').value.trim();
        const subject = document.getElementById('subject-{{ ai_gen_id }}').value;
        const message = document.getElementById('message-{{ ai_gen_id }}').value.trim();
        
        if (!name || !email || !subject || !message) {
          errorMsg.textContent = 'Please fill in all required fields.';
          errorMsg.classList.add('show');
          return;
        }
        
        if (!email.match(/^[^\s@]+@[^\s@]+\.[^\s@]+$/)) {
          errorMsg.textContent = 'Please enter a valid email address.';
          errorMsg.classList.add('show');
          return;
        }
        
        // Show loading state
        submitBtn.classList.add('loading');
        submitBtn.disabled = true;
        
        // Simulate form submission (replace with actual form submission)
        setTimeout(() => {
          submitBtn.classList.remove('loading');
          submitBtn.disabled = false;
          successMsg.classList.add('show');
          form.reset();
          
          // Hide success message after 5 seconds
          setTimeout(() => {
            successMsg.classList.remove('show');
          }, 5000);
        }, 1500);
        
