
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  /* ── Overlay ── */
  .ai-age-verify-overlay-{{ ai_gen_id }} {
    position: fixed;
    inset: 0;
    background: rgba(26, 13, 18, 0.88);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.4s ease, visibility 0.4s ease;
  }

  .ai-age-verify-overlay-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
    pointer-events: all;
  }

  /* ── Popup card ── */
  .ai-age-verify-popup-{{ ai_gen_id }} {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -48%) scale(0.94);
    background: linear-gradient(160deg, #FFF8F4 0%, #F6EEF2 100%);
    border-radius: 28px;
    padding: {{ block.settings.padding }}px;
    max-width: {{ block.settings.popup_width }}px;
    width: 90%;
    z-index: 9999;
    text-align: center;
    box-shadow:
      0 24px 60px -10px rgba(123, 30, 58, 0.28),
      0 8px 24px -4px rgba(123, 30, 58, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(212, 175, 55, 0.22);
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.4s ease, transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1), visibility 0.4s ease;
  }

  .ai-age-verify-popup-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
    pointer-events: all;
    transform: translate(-50%, -50%) scale(1);
  }

  /* ── Gold-pink top accent bar ── */
  .ai-age-verify-popup-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #D4AF37 0%, #E75480 50%, #7B1E3A 100%);
  }

  /* ── Brand badge ── */
  .ai-age-verify-brand-{{ ai_gen_id }} {
    font-family: 'Tomato Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #D4AF37;
    margin: 10px 0 18px;
  }

  /* ── Logo ── */
  .ai-age-verify-logo-{{ ai_gen_id }} {
    margin-bottom: 14px;
  }

  .ai-age-verify-logo-{{ ai_gen_id }} img {
    max-width: {{ block.settings.logo_width }}px;
    height: auto;
    margin: 0 auto;
    display: block;
  }

  /* ── Heading ── */
  .ai-age-verify-heading-{{ ai_gen_id }} {
    font-family: 'Tomato Grotesk', sans-serif;
    color: #1A0D12;
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0;
  }

  /* ── Gold divider ── */
  .ai-age-verify-divider-{{ ai_gen_id }} {
    width: 44px;
    height: 2px;
    background: linear-gradient(90deg, #D4AF37, #E75480);
    border-radius: 2px;
    margin: 16px auto 20px;
  }

  /* ── Message ── */
  .ai-age-verify-text-{{ ai_gen_id }} {
    color: #555;
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.65;
    margin: 0 0 28px;
  }

  .ai-age-verify-text-{{ ai_gen_id }} p {
    margin: 0;
  }

  /* ── Buttons row ── */
  .ai-age-verify-buttons-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .ai-age-verify-button-{{ ai_gen_id }} {
    padding: 14px 36px;
    border-radius: 60px;
    font-family: 'Tomato Grotesk', sans-serif;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    letter-spacing: 0.4px;
    cursor: pointer;
    transition: background 0.3s ease, transform 0.25s ease, box-shadow 0.3s ease;
    min-width: 140px;
  }

  /* Yes — solid pink */
  .ai-age-verify-button-yes-{{ ai_gen_id }} {
    background: #E75480;
    color: #fff;
    border: none;
    box-shadow: 0 6px 20px rgba(231, 84, 128, 0.35);
  }

  .ai-age-verify-button-yes-{{ ai_gen_id }}:hover {
    background: #7B1E3A;
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(123, 30, 58, 0.35);
  }

  /* No — ghost outline */
  .ai-age-verify-button-no-{{ ai_gen_id }} {
    background: transparent;
    color: #7B1E3A;
    border: 1.5px solid rgba(123, 30, 58, 0.28);
  }

  .ai-age-verify-button-no-{{ ai_gen_id }}:hover {
    background: rgba(123, 30, 58, 0.06);
    border-color: #7B1E3A;
    transform: translateY(-2px);
  }

  /* ── Footer ── */
  .ai-age-verify-footer-{{ ai_gen_id }} {
    margin-top: 22px;
    color: #aaa;
    font-size: 11px;
    line-height: 1.5;
    letter-spacing: 0.2px;
    border-top: 1px solid rgba(212, 175, 55, 0.14);
    padding-top: 14px;
  }

  /* ── Mobile ── */
  @media screen and (max-width: 749px) {
    .ai-age-verify-popup-{{ ai_gen_id }} {
      padding: {{ block.settings.padding | times: 0.75 | round }}px {{ block.settings.padding | times: 0.65 | round }}px;
    }

    .ai-age-verify-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.82 | round }}px;
    }

    .ai-age-verify-buttons-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-age-verify-button-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<age-verification-{{ ai_gen_id }} {{ block.shopify_attributes }}>
  <div class="ai-age-verify-overlay-{{ ai_gen_id }}"></div>

  <div class="ai-age-verify-popup-{{ ai_gen_id }}">

    {% if block.settings.logo %}
      <div class="ai-age-verify-logo-{{ ai_gen_id }}">
        <img
          src="{{ block.settings.logo | image_url: width: 400 }}"
          alt="{{ block.settings.logo.alt | escape }}"
          loading="eager"
          width="{{ block.settings.logo.width }}"
          height="{{ block.settings.logo.height }}"
        >
      </div>
    {% endif %}

    <p class="ai-age-verify-brand-{{ ai_gen_id }}">✦ Arousique ✦</p>

    <h2 class="ai-age-verify-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>

    <div class="ai-age-verify-divider-{{ ai_gen_id }}"></div>

    <div class="ai-age-verify-text-{{ ai_gen_id }}">
      {{ block.settings.message }}
    </div>

    <div class="ai-age-verify-buttons-{{ ai_gen_id }}">
      <button
        class="ai-age-verify-button-{{ ai_gen_id }} ai-age-verify-button-yes-{{ ai_gen_id }}"
        data-action="yes"
      >
        {{ block.settings.yes_button_text }}
      </button>
      <button
        class="ai-age-verify-button-{{ ai_gen_id }} ai-age-verify-button-no-{{ ai_gen_id }}"
        data-action="no"
      >
        {{ block.settings.no_button_text }}
      </button>
    </div>

    {% if block.settings.footer_text != blank %}
      <div class="ai-age-verify-footer-{{ ai_gen_id }}">
        {{ block.settings.footer_text }}
      </div>
    {% endif %}

  </div>
</age-verification-{{ ai_gen_id }}>

<script>
  (function() {
    class AgeVerification{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.storageKey = 'ai_age_verified_{{ ai_gen_id }}';
        this.overlay = this.querySelector('.ai-age-verify-overlay-{{ ai_gen_id }}');
        this.popup = this.querySelector('.ai-age-verify-popup-{{ ai_gen_id }}');
        this.yesButton = this.querySelector('[data-action="yes"]');
        this.noButton = this.querySelector('[data-action="no"]');
      }

      connectedCallback() {
        this.checkAgeVerification();
        this.setupEventListeners();
      }

      checkAgeVerification() {
        if (!sessionStorage.getItem(this.storageKey)) {
          // Defer one frame so the CSS transition fires on initial show
          requestAnimationFrame(() => this.showPopup());
        }
      }

      showPopup() {
        this.overlay.classList.add('active');
        this.popup.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      hidePopup() {
        this.overlay.classList.remove('active');
        this.popup.classList.remove('active');
        document.body.style.overflow = '';
      }

      setupEventListeners() {
        this.yesButton.addEventListener('click', () => {
          sessionStorage.setItem(this.storageKey, 'true');
          this.hidePopup();
        });

        this.noButton.addEventListener('click', () => {
          const redirectUrl = '{{ block.settings.redirect_url }}';
          if (redirectUrl && redirectUrl !== '') {
            window.location.href = redirectUrl;
          } else {
            this.popup.innerHTML = `
              <p class="ai-age-verify-brand-{{ ai_gen_id }}" style="margin-top:8px;">✦ Arousique ✦</p>
              <div class="ai-age-verify-divider-{{ ai_gen_id }}"></div>
              <p style="font-family:'Tomato Grotesk',sans-serif;color:#1A0D12;font-size:18px;font-weight:600;margin:0 0 8px;">Access Restricted</p>
              <p style="color:#666;font-size:14px;line-height:1.6;margin:0;">{{ block.settings.no_access_message | escape }}</p>
            `;
          }
        });
      }
    }

    customElements.define('age-verification-{{ ai_gen_id }}', AgeVerification{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Age verification popup",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 150
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Are you 18 or older?"
    },
    {
      "type": "richtext",
      "id": "message",
      "label": "Message",
      "default": "<p>Arousique is an intimate wellness destination for adults. Please confirm your age to enter.</p>"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer text",
      "default": "By entering you confirm you are 18+ and agree to our terms of service."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "yes_button_text",
      "label": "Yes button text",
      "default": "Yes, I'm 18+"
    },
    {
      "type": "text",
      "id": "no_button_text",
      "label": "No button text",
      "default": "No, exit"
    },
    {
      "type": "url",
      "id": "redirect_url",
      "label": "Redirect URL (for underage visitors)"
    },
    {
      "type": "text",
      "id": "no_access_message",
      "label": "No access message",
      "default": "You must be 18 or older to access this website."
    },
    {
      "type": "header",
      "content": "Popup style"
    },
    {
      "type": "range",
      "id": "popup_width",
      "min": 300,
      "max": 600,
      "step": 20,
      "unit": "px",
      "label": "Popup width",
      "default": 480
    },
    {
      "type": "range",
      "id": "padding",
      "min": 20,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Padding",
      "default": 44
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 18,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 30
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 15
    },
    {
      "type": "header",
      "content": "Button style"
    },
    {
      "type": "range",
      "id": "button_text_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Button text size",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "Age verification popup"
    }
  ]
}
{% endschema %}
