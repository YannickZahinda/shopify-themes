{% doc %}
  @prompt
    Create a responsive section with four rounded promotional cards arranged in two rows and two columns.
    
    Each card should have:
    
    Rounded corners (border-radius: 16px)
    
    Subtle shadow for depth
    
    White text area on top of a customizable background image (I will add the image later)
    
    Proper internal padding and balanced spacing
    
    Card content:
    
    Card 1:
    
    Title: “Discreet Packaging”
    
    Subtitle: “No mention of product or brand on shipping box.”
    
    Card 2:
    
    Title: “Never Used Before?”
    
    Subtitle: “No Get Our Free Course”
    
    Button: “LEARN MORE” (rounded button with bold uppercase text)
    
    Card 3:
    
    Title: “Get 15% off on your 1st order”
    
    Subtitle: “Copy Code: 15%OFF”
    
    Card 4:
    
    Title: “Get 15% off on your 1st order”
    
    Subtitle: “Copy Code: 15%OFF”
    
    Design requirements:
    
    Layout: grid with equal spacing and alignment.
    
    Text should be readable on top of background image (use gradient overlay or text-shadow if needed).
    
    Font style: modern, bold title and clean subtitle.
    
    Allow text and button customization from the Shopify theme editor.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-promo-cards-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-promo-cards-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.card_spacing }}px;
    max-width: 100%;
  }

  .ai-promo-card-{{ ai_gen_id }} {
    position: relative;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    box-shadow: {{ block.settings.shadow_horizontal }}px {{ block.settings.shadow_vertical }}px {{ block.settings.shadow_blur }}px rgba(0, 0, 0, {{ block.settings.shadow_opacity }});
    min-height: {{ block.settings.card_min_height }}px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .ai-promo-card-background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-promo-card-background-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-promo-card-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.placeholder_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-promo-card-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-promo-card-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, {{ block.settings.overlay_opacity }}) 0%,
      rgba(0, 0, 0, 0) 100%
    );
    z-index: 2;
  }

  .ai-promo-card-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 3;
    padding: {{ block.settings.content_padding }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-promo-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    margin: 0 0 {{ block.settings.title_spacing }}px;
    line-height: 1.2;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
  }

  .ai-promo-card-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    font-weight: 400;
    margin: 0;
    line-height: 1.4;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
  }

  .ai-promo-card-button-{{ ai_gen_id }} {
    display: inline-block;
    margin-top: {{ block.settings.button_spacing }}px;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-weight: 700;
    font-size: {{ block.settings.button_font_size }}px;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .ai-promo-card-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    transform: translateY(-2px);
  }

  @media screen and (max-width: 749px) {
    .ai-promo-cards-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.card_spacing | times: 0.75 }}px;
    }

    .ai-promo-card-{{ ai_gen_id }} {
      min-height: {{ block.settings.card_min_height | times: 0.8 }}px;
    }

    .ai-promo-card-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.85 }}px;
    }

    .ai-promo-card-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }

    .ai-promo-card-content-{{ ai_gen_id }} {
      padding: {{ block.settings.content_padding | times: 0.75 }}px;
    }
  }
{% endstyle %}

<div class="ai-promo-cards-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-promo-cards-container-{{ ai_gen_id }}">
    {% for i in (1..4) %}
      {% liquid
        assign card_enabled_key = 'card_' | append: i | append: '_enabled'
        assign card_image_key = 'card_' | append: i | append: '_image'
        assign card_title_key = 'card_' | append: i | append: '_title'
        assign card_subtitle_key = 'card_' | append: i | append: '_subtitle'
        assign card_button_text_key = 'card_' | append: i | append: '_button_text'
        assign card_button_link_key = 'card_' | append: i | append: '_button_link'
        assign card_show_button_key = 'card_' | append: i | append: '_show_button'

        assign card_enabled = block.settings[card_enabled_key]
        assign card_image = block.settings[card_image_key]
        assign card_title = block.settings[card_title_key]
        assign card_subtitle = block.settings[card_subtitle_key]
        assign card_button_text = block.settings[card_button_text_key]
        assign card_button_link = block.settings[card_button_link_key]
        assign card_show_button = block.settings[card_show_button_key]
      %}

      {% if card_enabled %}
        <div class="ai-promo-card-{{ ai_gen_id }}">
          <div class="ai-promo-card-background-{{ ai_gen_id }}">
            {% if card_image %}
              <img
                src="{{ card_image | image_url: width: 800 }}"
                alt="{{ card_image.alt | escape }}"
                loading="lazy"
                width="{{ card_image.width }}"
                height="{{ card_image.height }}"
              >
            {% else %}
              <div class="ai-promo-card-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="ai-promo-card-overlay-{{ ai_gen_id }}"></div>

          <div class="ai-promo-card-content-{{ ai_gen_id }}">
            {% if card_title != blank %}
              <h3 class="ai-promo-card-title-{{ ai_gen_id }}">{{ card_title }}</h3>
            {% endif %}

            {% if card_subtitle != blank %}
              <p class="ai-promo-card-subtitle-{{ ai_gen_id }}">{{ card_subtitle }}</p>
            {% endif %}

            {% if card_show_button and card_button_text != blank %}
              <a
                href="{{ card_button_link }}"
                class="ai-promo-card-button-{{ ai_gen_id }}"
              >
                {{ card_button_text }}
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

