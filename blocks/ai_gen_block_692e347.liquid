{% doc %}
  @prompt
    Create a 4-card promotional grid section (2x2 layout) with the following specifications:
    
    **Card 1 - Discreet Packaging:**
    - Background: Upload purple gradient image with person holding box
    - Overlay content (left-aligned):
      - Yellow lightning bolt icon ⚡
      - Heading: "Discreet Packaging" (white, bold, large)
      - Text: "No mention of product or brand on shipping box" (white, regular)
    - Circular product thumbnail in top-center position
    
    **Card 2 - Free Course:**
    - Background: Upload yellow gradient image with 3D lips
    - Overlay content (left-aligned):
      - Heading: "Never Used Before?" (dark purple, bold)
      - Text: "No Get Our Free Course" (dark purple with underline)
      - Button: "LEARN MORE →" (dark purple background, white text, rounded)
    - Yellow lightning bolt accents
    
    **Card 3 - First Order Discount (Blue Card):**
    - Background: Upload coral/pink gradient image with credit card
    - Overlay content:
      - Heading: "Get 15% off" (white, bold)
      - Text: "on your 1st order" (white)
      - Coupon: "Copy Code : 15%OFF" (white, prominent)
    - Pink lightning bolt decorations
    
    **Card 4 - First Order Discount (Pink Card):**
    - Background: Upload pink gradient image with circular platform
    - Overlay content:
      - Heading: "Get 15% off" (white, bold)
      - Text: "on your 1st order" (white)
      - Coupon: "Copy Code : 15%OFF" (white, prominent)
    - Pink lightning bolt accent
    
    **Section Settings:**
    - Card spacing: 14.79px gap between cards
    - Card padding: 29.59px
    - Rounded corners on all cards
    - Below section: Light pink background with centered text "Loved by Many. Desired by More." (purple text)
    - Make fully responsive for mobile (stack cards vertically)
    
    **Typography:**
    - Headings: Bold, 24-28px
    - Body text: Regular, 14-16px
    - Buttons: 16px, semi-bold, Decrease the range of adjusting height of card to around 50, I want to reduce the card height of 50 px ,
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-promo-grid-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;
  }

  .ai-promo-grid__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.card_gap }}px;
    margin-bottom: {{ block.settings.card_gap }}px;
  }

  .ai-promo-grid__card-{{ ai_gen_id }} {
    position: relative;
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    min-height: {{ block.settings.card_min_height }}px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .ai-promo-grid__card-bg-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-promo-grid__card-bg-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  }

  .ai-promo-grid__card-bg-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    opacity: 0.1;
  }

  .ai-promo-grid__card-content-{{ ai_gen_id }} {
    position: relative;
    padding: {{ block.settings.card_padding }}px;
    z-index: 2;
  }

  .ai-promo-grid__icon-{{ ai_gen_id }} {
    font-size: {{ block.settings.icon_size }}px;
    margin-bottom: 12px;
    display: inline-block;
  }

  .ai-promo-grid__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    margin: 0 0 8px 0;
    line-height: 1.2;
  }

  .ai-promo-grid__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    margin: 0 0 12px 0;
    line-height: 1.4;
  }

  .ai-promo-grid__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 24px;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    border: none;
    transition: all 0.3s ease;
  }

  .ai-promo-grid__coupon-{{ ai_gen_id }} {
    display: inline-block;
    padding: 10px 20px;
    border-radius: {{ block.settings.coupon_border_radius }}px;
    font-size: {{ block.settings.coupon_text_size }}px;
    font-weight: 600;
    cursor: pointer;
    border: 2px dashed rgba(255, 255, 255, 0.5);
    transition: all 0.3s ease;
  }

  .ai-promo-grid__coupon-{{ ai_gen_id }}:hover {
    border-color: rgba(255, 255, 255, 0.8);
    transform: scale(1.05);
  }

  .ai-promo-grid__thumbnail-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.thumbnail_top }}px;
    left: 50%;
    transform: translateX(-50%);
    width: {{ block.settings.thumbnail_size }}px;
    height: {{ block.settings.thumbnail_size }}px;
    border-radius: 50%;
    overflow: hidden;
    border: 4px solid rgba(255, 255, 255, 0.3);
    z-index: 3;
  }

  .ai-promo-grid__thumbnail-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-promo-grid__thumbnail-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-promo-grid__thumbnail-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.5;
  }

  .ai-promo-grid__footer-{{ ai_gen_id }} {
    background-color: {{ block.settings.footer_bg_color }};
    padding: {{ block.settings.footer_padding }}px;
    text-align: center;
  }

  .ai-promo-grid__footer-text-{{ ai_gen_id }} {
    color: {{ block.settings.footer_text_color }};
    font-size: {{ block.settings.footer_text_size }}px;
    font-weight: 600;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-promo-grid__container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.card_gap_mobile }}px;
      margin-bottom: {{ block.settings.card_gap_mobile }}px;
    }

    .ai-promo-grid__card-{{ ai_gen_id }} {
      min-height: {{ block.settings.card_min_height_mobile }}px;
    }

    .ai-promo-grid__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-promo-grid__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size_mobile }}px;
    }

    .ai-promo-grid__thumbnail-{{ ai_gen_id }} {
      width: {{ block.settings.thumbnail_size_mobile }}px;
      height: {{ block.settings.thumbnail_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-promo-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-promo-grid__container-{{ ai_gen_id }}">
    <div class="ai-promo-grid__card-{{ ai_gen_id }}">
      {% if block.settings.card1_image %}
        <img
          src="{{ block.settings.card1_image | image_url: width: 800 }}"
          alt="{{ block.settings.card1_image.alt | escape }}"
          class="ai-promo-grid__card-bg-{{ ai_gen_id }}"
          loading="lazy"
          width="800"
          height="600"
        >
      {% else %}
        <div class="ai-promo-grid__card-bg-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}

      {% if block.settings.card1_show_thumbnail %}
        <div class="ai-promo-grid__thumbnail-{{ ai_gen_id }}">
          {% if block.settings.card1_thumbnail %}
            <img
              src="{{ block.settings.card1_thumbnail | image_url: width: 200 }}"
              alt="{{ block.settings.card1_thumbnail.alt | escape }}"
              loading="lazy"
              width="200"
              height="200"
            >
          {% else %}
            <div class="ai-promo-grid__thumbnail-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      {% endif %}

      <div class="ai-promo-grid__card-content-{{ ai_gen_id }}">
        {% if block.settings.card1_icon != blank %}
          <div class="ai-promo-grid__icon-{{ ai_gen_id }}" style="color: {{ block.settings.card1_icon_color }};">
            {{ block.settings.card1_icon }}
          </div>
        {% endif %}
        {% if block.settings.card1_heading != blank %}
          <h3 class="ai-promo-grid__heading-{{ ai_gen_id }}" style="color: {{ block.settings.card1_heading_color }};">
            {{ block.settings.card1_heading }}
          </h3>
        {% endif %}
        {% if block.settings.card1_text != blank %}
          <p class="ai-promo-grid__text-{{ ai_gen_id }}" style="color: {{ block.settings.card1_text_color }};">
            {{ block.settings.card1_text }}
          </p>
        {% endif %}
      </div>
    </div>

    <div class="ai-promo-grid__card-{{ ai_gen_id }}">
      {% if block.settings.card2_image %}
        <img
          src="{{ block.settings.card2_image | image_url: width: 800 }}"
          alt="{{ block.settings.card2_image.alt | escape }}"
          class="ai-promo-grid__card-bg-{{ ai_gen_id }}"
          loading="lazy"
          width="800"
          height="600"
        >
      {% else %}
        <div class="ai-promo-grid__card-bg-placeholder-{{ ai_gen_id }}" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}

      <div class="ai-promo-grid__card-content-{{ ai_gen_id }}">
        {% if block.settings.card2_icon != blank %}
          <div class="ai-promo-grid__icon-{{ ai_gen_id }}" style="color: {{ block.settings.card2_icon_color }};">
            {{ block.settings.card2_icon }}
          </div>
        {% endif %}
        {% if block.settings.card2_heading != blank %}
          <h3 class="ai-promo-grid__heading-{{ ai_gen_id }}" style="color: {{ block.settings.card2_heading_color }};">
            {{ block.settings.card2_heading }}
          </h3>
        {% endif %}
        {% if block.settings.card2_text != blank %}
          <div class="ai-promo-grid__text-{{ ai_gen_id }}" style="color: {{ block.settings.card2_text_color }};">
            {{ block.settings.card2_text }}
          </div>
        {% endif %}
        {% if block.settings.card2_button_text != blank %}
          <a
            href="{{ block.settings.card2_button_link }}"
            class="ai-promo-grid__button-{{ ai_gen_id }}"
            style="background-color: {{ block.settings.card2_button_bg }}; color: {{ block.settings.card2_button_text_color }};"
          >
            {{ block.settings.card2_button_text }}
          </a>
        {% endif %}
      </div>
    </div>

    <div class="ai-promo-grid__card-{{ ai_gen_id }}">
      {% if block.settings.card3_image %}
        <img
          src="{{ block.settings.card3_image | image_url: width: 800 }}"
          alt="{{ block.settings.card3_image.alt | escape }}"
          class="ai-promo-grid__card-bg-{{ ai_gen_id }}"
          loading="lazy"
          width="800"
          height="600"
        >
      {% else %}
        <div class="ai-promo-grid__card-bg-placeholder-{{ ai_gen_id }}" style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}

      <div class="ai-promo-grid__card-content-{{ ai_gen_id }}">
        {% if block.settings.card3_icon != blank %}
          <div class="ai-promo-grid__icon-{{ ai_gen_id }}" style="color: {{ block.settings.card3_icon_color }};">
            {{ block.settings.card3_icon }}
          </div>
        {% endif %}
        {% if block.settings.card3_heading != blank %}
          <h3 class="ai-promo-grid__heading-{{ ai_gen_id }}" style="color: {{ block.settings.card3_heading_color }};">
            {{ block.settings.card3_heading }}
          </h3>
        {% endif %}
        {% if block.settings.card3_text != blank %}
          <p class="ai-promo-grid__text-{{ ai_gen_id }}" style="color: {{ block.settings.card3_text_color }};">
            {{ block.settings.card3_text }}
          </p>
        {% endif %}
        {% if block.settings.card3_coupon_text != blank %}
          <div
            class="ai-promo-grid__coupon-{{ ai_gen_id }}"
            style="background-color: {{ block.settings.card3_coupon_bg }}; color: {{ block.settings.card3_coupon_text_color }};"
            onclick="navigator.clipboard.writeText('{{ block.settings.card3_coupon_code }}')"
            role="button"
            tabindex="0"
            aria-label="Copy coupon code {{ block.settings.card3_coupon_code }}"
          >
            {{ block.settings.card3_coupon_text }}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-promo-grid__card-{{ ai_gen_id }}">
      {% if block.settings.card4_image %}
        <img
          src="{{ block.settings.card4_image | image_url: width: 800 }}"
          alt="{{ block.settings.card4_image.alt | escape }}"
          class="ai-promo-grid__card-bg-{{ ai_gen_id }}"
          loading="lazy"
          width="800"
          height="600"
        >
      {% else %}
        <div class="ai-promo-grid__card-bg-placeholder-{{ ai_gen_id }}" style="background: linear-gradient(135deg, #fbc2eb 0%, #a6c1ee 100%);">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}

      <div class="ai-promo-grid__card-content-{{ ai_gen_id }}">
        {% if block.settings.card4_icon != blank %}
          <div class="ai-promo-grid__icon-{{ ai_gen_id }}" style="color: {{ block.settings.card4_icon_color }};">
            {{ block.settings.card4_icon }}
          </div>
        {% endif %}
        {% if block.settings.card4_heading != blank %}
          <h3 class="ai-promo-grid__heading-{{ ai_gen_id }}" style="color: {{ block.settings.card4_heading_color }};">
            {{ block.settings.card4_heading }}
          </h3>
        {% endif %}
        {% if block.settings.card4_text != blank %}
          <p class="ai-promo-grid__text-{{ ai_gen_id }}" style="color: {{ block.settings.card4_text_color }};">
            {{ block.settings.card4_text }}
          </p>
        {% endif %}
        {% if block.settings.card4_coupon_text != blank %}
          <div
            class="ai-promo-grid__coupon-{{ ai_gen_id }}"
            style="background-color: {{ block.settings.card4_coupon_bg }}; color: {{ block.settings.card4_coupon_text_color }};"
            onclick="navigator.clipboard.writeText('{{ block.settings.card4_coupon_code }}')"
            role="button"
            tabindex="0"
            aria-label="Copy coupon code {{ block.settings.card4_coupon_code }}"
          >
            {{ block.settings.card4_coupon_text }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  {% if block.settings.show_footer %}
    <div class="ai-promo-grid__footer-{{ ai_gen_id }}">
      <p class="ai-promo-grid__footer-text-{{ ai_gen_id }}">{{ block.settings.footer_text }}</p>
    </div>
  {% endif %}
</div>

