<div class="account-actions">
  <div class="account-actions__main-menu">
    <header class="account-actions__header">
      <h2
        id="account-drawer-heading"
        class="account-actions__title h5"
      >
        {% if customer and customer.first_name != blank %}
          {{ 'content.account_title_personalized' | t: first_name: customer.first_name }}
        {% else %}
          {{ 'content.account_title' | t }}
        {% endif %}
      </h2>
      {% if customer %}
        <span class="account-actions__email">
          {% if customer.email %}
            {{ customer.email }}
          {% elsif customer.phone %}
            {{ customer.phone }}
          {% endif %}
        </span>
      {% endif %}
    </header>

    {% unless customer %}
      <div
        class="account-actions__sign-ins"
        data-skip-subtree-update="true"
      >
        <script
          src="{{ 'account-login-actions.js' | asset_url }}"
          type="module"
          fetchpriority="low"
        ></script>
        <account-login-actions class="account-actions__shop-login">
          {{ shop | login_button }}
        </account-login-actions>

        <div class="account-actions__divider" aria-hidden="true"><span>or</span></div>

        <a
          href="{% if request.design_mode %}{{ routes.account_url }}{% else %}{{ routes.storefront_login_url }}{% endif %}"
          class="account-actions__link account-actions__other-signin"
        >
          <span class="account-actions__sign-in-text">
            {{ 'actions.sign_in_options' | t }}
          </span>
          <span class="account-actions__fallback-text">
            {{ 'actions.log_in' | t }}
          </span>
        </a>
      </div>
    {% endunless %}

    <nav class="account-actions__nav">
      <ul class="account-actions__list">
        <li class="account-actions__list-item">
          <a
            href="{{ routes.account_url }}"
            class="account-actions__link button-secondary"
          >
            <span
              class="account-actions__icon"
              aria-hidden="true"
            >
              {{- 'icon-orders.svg' | inline_asset_content -}}
            </span>
            {{ 'content.account_orders' | t }}
          </a>
        </li>
        <li class="account-actions__list-item">
          <a
            href="{{ routes.account_addresses_url }}"
            class="account-actions__link button-secondary"
          >
            <span
              class="account-actions__icon"
              aria-hidden="true"
            >
              {{- 'icon-account.svg' | inline_asset_content -}}
            </span>
            {{ 'content.account_profile' | t }}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</div>

{% stylesheet %}

  /* ══════════════════════════════════════
     ACCOUNT POPUP — Arousique Dark Theme
  ══════════════════════════════════════ */

  .account-actions {
    background: linear-gradient(160deg, #1A0D12 0%, #2D1B2E 100%);
    display: flex;
    flex-direction: column;
    position: relative;
    transition: height var(--animation-values);
    border-radius: inherit;
    overflow: hidden;

    &:has([data-active]) .account-actions__main-menu {
      visibility: hidden;
    }
  }

  /* ── Header ── */
  .account-actions__header {
    padding: 22px 24px 18px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    border-bottom: 1px solid rgba(212, 175, 55, 0.15);
    position: relative;
  }

  /* Gold dot accent before title */
  .account-actions__header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, #D4AF37, #E75480, transparent);
  }

  .account-actions__title {
    --font-h5--size: var(--font-size--lg);
    margin: 0;
    color: #F6EEF2 !important;
    -webkit-text-fill-color: #F6EEF2 !important;
    font-size: 18px !important;
    font-weight: 700 !important;
    letter-spacing: 0.01em;
    display: flex;
    align-items: center;
    gap: 10px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .account-actions__title::before {
    content: '';
    width: 8px;
    height: 8px;
    min-width: 8px;
    background: #D4AF37;
    border-radius: 50%;
    box-shadow: 0 0 8px rgba(212, 175, 55, 0.6);
  }

  .account-actions__email {
    display: flex;
    align-items: center;
    gap: 6px;
    color: rgba(246, 238, 242, 0.45) !important;
    -webkit-text-fill-color: rgba(246, 238, 242, 0.45) !important;
    font-size: 12px;
    max-width: var(--account-actions-max-width);
    word-break: break-all;
    padding-left: 18px;
  }

  /* ── Sign-in buttons area ── */
  .account-actions__sign-ins {
    padding: 20px 24px 16px;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .account-actions__sign-in-text { display: inline; }
  .account-actions__fallback-text { display: none; }

  .account-actions__sign-ins:not(:has(shop-login-button)) {
    .account-actions__sign-in-text { display: none; }
    .account-actions__fallback-text { display: block; }
  }

  /* Shop login button wrapper — CSS filter shifts purple → brand dark rose */
  .account-actions__shop-login {
    --buttons-radius: 50px;
    filter: hue-rotate(91deg) saturate(62%) brightness(56%);
    transition: filter 0.25s ease;
  }

  .account-actions__shop-login:hover {
    filter: hue-rotate(91deg) saturate(70%) brightness(48%);
  }

  /* ── "or" divider ── */
  .account-actions__divider {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 12px 0;
    color: rgba(246, 238, 242, 0.25);
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .account-actions__divider::before,
  .account-actions__divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: rgba(212, 175, 55, 0.12);
  }

  .account-actions__divider span {
    flex-shrink: 0;
    color: rgba(246, 238, 242, 0.3);
    -webkit-text-fill-color: rgba(246, 238, 242, 0.3);
  }

  /* ── "Other sign in options" — gold CTA ── */
  .account-actions__other-signin {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    background: #D4AF37 !important;
    background-color: #D4AF37 !important;
    color: #1A0D12 !important;
    -webkit-text-fill-color: #1A0D12 !important;
    border: none !important;
    border-radius: 50px !important;
    padding: 13px 24px !important;
    font-size: 14px !important;
    font-weight: 700 !important;
    letter-spacing: 0.3px !important;
    text-decoration: none !important;
    box-shadow: 0 4px 16px rgba(212, 175, 55, 0.25) !important;
    transition: background 0.25s, transform 0.2s, box-shadow 0.25s !important;
    width: 100%;
  }

  .account-actions__other-signin:hover {
    background: #C9A430 !important;
    background-color: #C9A430 !important;
    color: #1A0D12 !important;
    -webkit-text-fill-color: #1A0D12 !important;
    transform: translateY(-1px) !important;
    box-shadow: 0 8px 22px rgba(212, 175, 55, 0.35) !important;
  }

  /* ── Orders / Profile nav tiles ── */
  .account-actions__nav {
    padding: 0 24px 22px;
  }

  .account-actions__list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    width: 100%;
    list-style: none;
    margin: 0;
    padding: 0;

    @media screen and (max-width: 300px) {
      grid-template-columns: 1fr;
    }
  }

  .account-actions__link {
    width: auto;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
    text-decoration: none;
  }

  .account-actions__link.button-secondary {
    background: rgba(246, 238, 242, 0.04) !important;
    color: rgba(246, 238, 242, 0.65) !important;
    -webkit-text-fill-color: rgba(246, 238, 242, 0.65) !important;
    border: 1px solid rgba(212, 175, 55, 0.18) !important;
    border-radius: 12px !important;
    padding: 12px 8px !important;
    font-size: 13px !important;
    font-weight: 500 !important;
    transition: all 0.2s !important;
  }

  .account-actions__link.button-secondary:hover {
    background: rgba(212, 175, 55, 0.1) !important;
    color: #D4AF37 !important;
    -webkit-text-fill-color: #D4AF37 !important;
    border-color: rgba(212, 175, 55, 0.4) !important;
  }

  .account-actions__icon {
    display: flex;
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
    margin-block: -4px;
  }

  .account-actions__icon svg {
    color: #D4AF37 !important;
    stroke: #D4AF37 !important;
  }

  @supports not (background-color: rgb(from red 150 g b / alpha)) {
    .account-actions :is(a.button, a.button-secondary):focus-visible {
      outline: none;
      overflow: visible;
      position: relative;

      &::after {
        content: '';
        position: absolute;
        inset: calc(-1 * var(--focus-outline-offset));
        border: var(--focus-outline-width) solid currentColor;
        border-radius: var(--style-border-radius-buttons-secondary);
        display: inherit;
      }
    }
  }

{% endstylesheet %}
