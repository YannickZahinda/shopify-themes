{% assign ai_gen_id = 'default' %}

{% style %}
  .ai-age-verify-overlay-{{ ai_gen_id }} {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.35s ease, visibility 0.35s ease;
  }

  .ai-age-verify-overlay-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
    pointer-events: all;
  }

  .ai-age-verify-popup-{{ ai_gen_id }} {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -46%) scale(0.95);
    background-color: #FF6FA3;
    border-radius: 28px;
    padding: 48px 36px 36px;
    max-width: 400px;
    width: 90%;
    z-index: 9999;
    text-align: center;
    box-shadow: 0 20px 60px rgba(255, 70, 130, 0.35), 0 8px 24px rgba(0, 0, 0, 0.15);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    overflow: hidden;
    transition: opacity 0.4s ease, transform 0.45s cubic-bezier(0.34, 1.4, 0.64, 1), visibility 0.4s ease;
  }

  .ai-age-verify-popup-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
    pointer-events: all;
    transform: translate(-50%, -50%) scale(1);
  }

  .ai-age-verify-bg-svg-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  /* Brand icon at top */
  .ai-age-verify-icon-{{ ai_gen_id }} {
    margin: 0 auto 20px;
    width: 54px;
    height: 54px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 1;
  }

  .ai-age-verify-icon-{{ ai_gen_id }} svg {
    width: 54px;
    height: 54px;
    fill: none;
    stroke: #fff;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.15));
  }

  /* Heading */
  .ai-age-verify-heading-{{ ai_gen_id }} {
    font-family: 'Tomato Grotesk', sans-serif;
    font-size: 26px;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 28px;
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-shadow: 0 2px 8px rgba(0,0,0,0.18);
    position: relative;
    z-index: 1;
  }

  /* Buttons */
  .ai-age-verify-buttons-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  /* Primary — white pill */
  .ai-age-verify-button-yes-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 16px 32px;
    background: #ffffff;
    color: #FF3D85;
    border: none;
    border-radius: 50px;
    font-family: 'Tomato Grotesk', sans-serif;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    letter-spacing: 0.1px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.12);
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .ai-age-verify-button-yes-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(0,0,0,0.18);
    background: #fff5f8;
  }

  /* Secondary — text link only */
  .ai-age-verify-button-no-{{ ai_gen_id }} {
    display: inline-block;
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.95);
    font-family: 'Tomato Grotesk', sans-serif;
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
    padding: 4px 0;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.2s ease;
  }

  .ai-age-verify-button-no-{{ ai_gen_id }}:hover {
    opacity: 0.75;
  }

  /* Footer */
  .ai-age-verify-footer-{{ ai_gen_id }} {
    margin-top: 24px;
    color: rgba(255, 255, 255, 0.75);
    font-size: 11px;
    line-height: 1.6;
    letter-spacing: 0.1px;
    position: relative;
    z-index: 1;
  }

  @media (max-width: 749px) {
    .ai-age-verify-popup-{{ ai_gen_id }} {
      padding: 40px 24px 28px;
      max-width: 340px;
    }

    .ai-age-verify-heading-{{ ai_gen_id }} {
      font-size: 22px;
    }
  }
{% endstyle %}

<age-verification-{{ ai_gen_id }}>
  <div class="ai-age-verify-overlay-{{ ai_gen_id }}"></div>

  <div class="ai-age-verify-popup-{{ ai_gen_id }}">

    <!-- Abstract gradient background — inline SVG, no external files needed -->
    <svg class="ai-age-verify-bg-svg-{{ ai_gen_id }}"
         xmlns="http://www.w3.org/2000/svg"
         viewBox="0 0 400 520"
         preserveAspectRatio="xMidYMid slice"
         aria-hidden="true"
         focusable="false">
      <defs>
        <filter id="bb-xl-{{ ai_gen_id }}" x="-80%" y="-80%" width="260%" height="260%">
          <feGaussianBlur stdDeviation="68"/>
        </filter>
        <filter id="bb-lg-{{ ai_gen_id }}" x="-70%" y="-70%" width="240%" height="240%">
          <feGaussianBlur stdDeviation="50"/>
        </filter>
        <filter id="bb-md-{{ ai_gen_id }}" x="-60%" y="-60%" width="220%" height="220%">
          <feGaussianBlur stdDeviation="38"/>
        </filter>
      </defs>

      <!-- Base: warm pink -->
      <rect width="400" height="520" fill="#FF6FA3"/>

      <!-- Large peach/apricot blob — top right corner -->
      <ellipse cx="440" cy="-40"
               rx="320" ry="280"
               fill="#FFD4A0" opacity="0.75"
               filter="url(#bb-xl-{{ ai_gen_id }})"/>

      <!-- Large warm peach blob — bottom left corner -->
      <ellipse cx="-40" cy="565"
               rx="300" ry="265"
               fill="#FFC07A" opacity="0.68"
               filter="url(#bb-xl-{{ ai_gen_id }})"/>

      <!-- Soft rose accent — upper left -->
      <ellipse cx="50" cy="95"
               rx="215" ry="195"
               fill="#FFB8D0" opacity="0.50"
               filter="url(#bb-lg-{{ ai_gen_id }})"/>

      <!-- Light beige diagonal ribbon — flows bottom-left to top-right -->
      <ellipse cx="195" cy="258"
               rx="320" ry="118"
               fill="#FFE8D2" opacity="0.38"
               transform="rotate(-37 195 258)"
               filter="url(#bb-lg-{{ ai_gen_id }})"/>

      <!-- Coral accent — mid right -->
      <ellipse cx="400" cy="335"
               rx="210" ry="180"
               fill="#FF7080" opacity="0.36"
               filter="url(#bb-md-{{ ai_gen_id }})"/>

      <!-- Deep rose — bottom right depth anchor -->
      <ellipse cx="415" cy="530"
               rx="245" ry="215"
               fill="#FF3E6E" opacity="0.30"
               filter="url(#bb-xl-{{ ai_gen_id }})"/>

      <!-- Warm cream highlight — center softener -->
      <ellipse cx="200" cy="240"
               rx="180" ry="155"
               fill="#FFECD8" opacity="0.22"
               filter="url(#bb-lg-{{ ai_gen_id }})"/>

    </svg>

    <div class="ai-age-verify-icon-{{ ai_gen_id }}">
      <svg viewBox="0 0 54 54" xmlns="http://www.w3.org/2000/svg">
        <path d="M27 48 C27 48 8 36 8 22 C8 15 13.5 10 20 10 C23.5 10 26.5 11.8 27 13 C27.5 11.8 30.5 10 34 10 C40.5 10 46 15 46 22 C46 36 27 48 27 48Z" stroke="white" stroke-width="2" fill="rgba(255,255,255,0.15)"/>
        <path d="M22 28 C20 24 21 18 25 17" stroke="white" stroke-width="1.8" fill="none"/>
      </svg>
    </div>

    <h2 class="ai-age-verify-heading-{{ ai_gen_id }}">Are you over 21?</h2>

    <div class="ai-age-verify-buttons-{{ ai_gen_id }}">
      <button
        class="ai-age-verify-button-yes-{{ ai_gen_id }}"
        data-action="yes"
      >
        Yes I'm 21+ years old
      </button>
      <button
        class="ai-age-verify-button-no-{{ ai_gen_id }}"
        data-action="no"
      >
        Exit
      </button>
    </div>

    <p class="ai-age-verify-footer-{{ ai_gen_id }}">
      By entering the website, you are agreeing to the Terms of Use and Privacy Policy.
    </p>

  </div>
</age-verification-{{ ai_gen_id }}>

<script>
(function() {
  class AgeVerification extends HTMLElement {
    constructor() {
      super();
      this.key = 'ai_age_verified';
      this.overlay = this.querySelector('.ai-age-verify-overlay-default');
      this.popup = this.querySelector('.ai-age-verify-popup-default');
      this.yes = this.querySelector('[data-action="yes"]');
      this.no = this.querySelector('[data-action="no"]');
    }

    connectedCallback() {
      if (!sessionStorage.getItem(this.key)) {
        requestAnimationFrame(() => this.show());
      }

      this.yes.addEventListener('click', () => {
        sessionStorage.setItem(this.key, 'true');
        this.hide();
      });

      this.no.addEventListener('click', () => {
        window.location.href = 'https://www.google.com';
      });
    }

    show() {
      this.overlay.classList.add('active');
      this.popup.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    hide() {
      this.overlay.classList.remove('active');
      this.popup.classList.remove('active');
      document.body.style.overflow = '';
    }
  }

  customElements.define('age-verification-default', AgeVerification);
})();
</script>
