{% assign ai_gen_id = 'default' %}

{% style %}
  .ai-age-verify-overlay-{{ ai_gen_id }} {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.35s ease, visibility 0.35s ease;
  }

  .ai-age-verify-overlay-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
    pointer-events: all;
  }

  .ai-age-verify-popup-{{ ai_gen_id }} {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -46%) scale(0.95);
    background-color: #D97080;
    border-radius: 28px;
    padding: 48px 36px 36px;
    max-width: 400px;
    width: 90%;
    z-index: 9999;
    text-align: center;
    box-shadow: 0 20px 60px rgba(200, 60, 100, 0.30), 0 8px 24px rgba(0, 0, 0, 0.15);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    overflow: hidden;
    transition: opacity 0.4s ease, transform 0.45s cubic-bezier(0.34, 1.4, 0.64, 1), visibility 0.4s ease;
  }

  .ai-age-verify-popup-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
    pointer-events: all;
    transform: translate(-50%, -50%) scale(1);
  }

  .ai-age-verify-bg-svg-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  /* Brand icon at top */
  .ai-age-verify-icon-{{ ai_gen_id }} {
    margin: 0 auto 20px;
    width: 54px;
    height: 54px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 1;
  }

  .ai-age-verify-icon-{{ ai_gen_id }} svg {
    width: 54px;
    height: 54px;
    fill: none;
    stroke: #fff;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.12));
  }

  /* Heading */
  .ai-age-verify-heading-{{ ai_gen_id }} {
    font-family: 'Tomato Grotesk', sans-serif;
    font-size: 26px;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 28px;
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-shadow: 0 1px 6px rgba(0,0,0,0.12);
    position: relative;
    z-index: 1;
  }

  /* Buttons */
  .ai-age-verify-buttons-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  /* Primary — white pill */
  .ai-age-verify-button-yes-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 16px 32px;
    background: #ffffff;
    color: #D9426E;
    border: none;
    border-radius: 50px;
    font-family: 'Tomato Grotesk', sans-serif;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    letter-spacing: 0.1px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.10);
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .ai-age-verify-button-yes-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(0,0,0,0.16);
    background: #fff5f7;
  }

  /* Secondary — text link only */
  .ai-age-verify-button-no-{{ ai_gen_id }} {
    display: inline-block;
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.95);
    font-family: 'Tomato Grotesk', sans-serif;
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
    padding: 4px 0;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.2s ease;
  }

  .ai-age-verify-button-no-{{ ai_gen_id }}:hover {
    opacity: 0.75;
  }

  /* Footer */
  .ai-age-verify-footer-{{ ai_gen_id }} {
    margin-top: 24px;
    color: rgba(255, 255, 255, 0.75);
    font-size: 11px;
    line-height: 1.6;
    letter-spacing: 0.1px;
    position: relative;
    z-index: 1;
  }

  @media (max-width: 749px) {
    .ai-age-verify-popup-{{ ai_gen_id }} {
      padding: 40px 24px 28px;
      max-width: 340px;
    }

    .ai-age-verify-heading-{{ ai_gen_id }} {
      font-size: 22px;
    }
  }
{% endstyle %}

<age-verification-{{ ai_gen_id }}>
  <div class="ai-age-verify-overlay-{{ ai_gen_id }}"></div>

  <div class="ai-age-verify-popup-{{ ai_gen_id }}">

    <!--
      Abstract gradient background — 3 organic blob shapes:
        1. Warm salmon-pink base
        2. Large soft blush/peach blob  — top-left
        3. Vibrant hot-pink blob        — right side, S-curve boundary
        4. Small blush teardrop accent  — bottom-right corner
    -->
    <svg class="ai-age-verify-bg-svg-{{ ai_gen_id }}"
         xmlns="http://www.w3.org/2000/svg"
         viewBox="0 0 400 500"
         preserveAspectRatio="none"
         aria-hidden="true"
         focusable="false">
      <defs>

        <!-- Blush blob gradient: very light peachy-cream at corner, warming outward -->
        <radialGradient id="rg-blush-{{ ai_gen_id }}"
                        cx="30" cy="28" r="315"
                        gradientUnits="userSpaceOnUse">
          <stop offset="0%"   stop-color="#F8CAB8"/>
          <stop offset="55%"  stop-color="#F1B0A0"/>
          <stop offset="100%" stop-color="#EAAA98"/>
        </radialGradient>

        <!-- Pink blob gradient: bright hot-pink at top-right, deepening toward center -->
        <radialGradient id="rg-pink-{{ ai_gen_id }}"
                        cx="392" cy="18" r="390"
                        gradientUnits="userSpaceOnUse">
          <stop offset="0%"   stop-color="#F84888"/>
          <stop offset="40%"  stop-color="#EE3878"/>
          <stop offset="100%" stop-color="#D42870"/>
        </radialGradient>

        <!-- Soft edge feathering for all blobs -->
        <filter id="feather-{{ ai_gen_id }}" x="-12%" y="-10%" width="124%" height="120%">
          <feGaussianBlur stdDeviation="15"/>
        </filter>

      </defs>

      <!-- Base: warm salmon-pink -->
      <rect width="400" height="500" fill="#D97080"/>

      <!--
        Top-left blush blob.
        Starts at top-left corner, sweeps across top to ~x 290,
        then curves down and left back to the left edge at ~y 340.
      -->
      <path d="
        M -18 -18
        C 172 -18 302 28 290 128
        C 278 228 152 288 82 348
        C 30 392 -18 376 -18 336
        Z"
        fill="url(#rg-blush-{{ ai_gen_id }})"
        filter="url(#feather-{{ ai_gen_id }})"/>

      <!--
        Right hot-pink blob with S-curve left boundary.
        Top: pink begins at x≈205.
        Curves left to x≈135 at y≈90  (blush expands in upper-middle).
        Swings right to x≈350 at y≈385 (pink expands in lower-middle).
        Returns slightly left to x≈305 at the bottom.
      -->
      <path d="
        M 418 -18
        L 205 -18
        C 184 24 135 88 160 174
        C 185 260 342 294 357 383
        C 367 438 320 508 303 518
        L 418 518
        Z"
        fill="url(#rg-pink-{{ ai_gen_id }})"
        filter="url(#feather-{{ ai_gen_id }})"/>

      <!-- Small blush teardrop — bottom-right corner accent -->
      <ellipse cx="390" cy="478" rx="110" ry="86"
               fill="#F6C6B4" opacity="0.90"
               filter="url(#feather-{{ ai_gen_id }})"/>

    </svg>

    <div class="ai-age-verify-icon-{{ ai_gen_id }}">
      <svg viewBox="0 0 54 54" xmlns="http://www.w3.org/2000/svg">
        <path d="M27 48 C27 48 8 36 8 22 C8 15 13.5 10 20 10 C23.5 10 26.5 11.8 27 13 C27.5 11.8 30.5 10 34 10 C40.5 10 46 15 46 22 C46 36 27 48 27 48Z" stroke="white" stroke-width="2" fill="rgba(255,255,255,0.15)"/>
        <path d="M22 28 C20 24 21 18 25 17" stroke="white" stroke-width="1.8" fill="none"/>
      </svg>
    </div>

    <h2 class="ai-age-verify-heading-{{ ai_gen_id }}">Are you over 21?</h2>

    <div class="ai-age-verify-buttons-{{ ai_gen_id }}">
      <button
        class="ai-age-verify-button-yes-{{ ai_gen_id }}"
        data-action="yes"
      >
        Yes I'm 21+ years old
      </button>
      <button
        class="ai-age-verify-button-no-{{ ai_gen_id }}"
        data-action="no"
      >
        Exit
      </button>
    </div>

    <p class="ai-age-verify-footer-{{ ai_gen_id }}">
      By entering the website, you are agreeing to the Terms of Use and Privacy Policy.
    </p>

  </div>
</age-verification-{{ ai_gen_id }}>

<script>
(function() {
  class AgeVerification extends HTMLElement {
    constructor() {
      super();
      this.key = 'ai_age_verified';
      this.overlay = this.querySelector('.ai-age-verify-overlay-default');
      this.popup = this.querySelector('.ai-age-verify-popup-default');
      this.yes = this.querySelector('[data-action="yes"]');
      this.no = this.querySelector('[data-action="no"]');
    }

    connectedCallback() {
      if (!sessionStorage.getItem(this.key)) {
        requestAnimationFrame(() => this.show());
      }

      this.yes.addEventListener('click', () => {
        sessionStorage.setItem(this.key, 'true');
        this.hide();
      });

      this.no.addEventListener('click', () => {
        window.location.href = 'https://www.google.com';
      });
    }

    show() {
      this.overlay.classList.add('active');
      this.popup.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    hide() {
      this.overlay.classList.remove('active');
      this.popup.classList.remove('active');
      document.body.style.overflow = '';
    }
  }

  customElements.define('age-verification-default', AgeVerification);
})();
</script>
