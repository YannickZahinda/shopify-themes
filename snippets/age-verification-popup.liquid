{% assign ai_gen_id = 'default' %}

{% style %}
  .ai-age-verify-overlay-{{ ai_gen_id }} {
    position: fixed;
    inset: 0;
    background-color: rgba(12, 9, 6, 0.58);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.35s ease, visibility 0.35s ease;
  }

  .ai-age-verify-overlay-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
    pointer-events: all;
  }

  .ai-age-verify-popup-{{ ai_gen_id }} {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -46%) scale(0.96);
    background: #FDFAF6;
    border: 1px solid rgba(212, 175, 55, 0.22);
    border-radius: 24px;
    padding: 52px 40px 36px;
    max-width: 420px;
    width: 90%;
    z-index: 9999;
    text-align: center;
    box-shadow:
      0 2px 6px rgba(0, 0, 0, 0.04),
      0 16px 48px rgba(180, 140, 30, 0.12),
      0 32px 64px rgba(0, 0, 0, 0.06);
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.38s ease, transform 0.42s cubic-bezier(0.34, 1.4, 0.64, 1), visibility 0.38s ease;
  }

  /* Gold top accent bar */
  .ai-age-verify-popup-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #F0D060 0%, #D4AF37 45%, #B8903A 100%);
  }

  .ai-age-verify-popup-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
    pointer-events: all;
    transform: translate(-50%, -50%) scale(1);
  }

  .ai-age-verify-icon-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 56px;
    height: 56px;
    background: #FBF5E0;
    border: 1px solid rgba(212, 175, 55, 0.4);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(212, 175, 55, 0.18);
  }

  .ai-age-verify-icon-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
    stroke: #C9A030;
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ai-age-verify-brand-{{ ai_gen_id }} {
    display: inline-block;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #B8903A;
    background: #FBF5E0;
    border: 0.5px solid rgba(212, 175, 55, 0.35);
    border-radius: 20px;
    padding: 4px 14px;
    margin-bottom: 18px;
  }

  .ai-age-verify-heading-{{ ai_gen_id }} {
    font-size: 22px;
    font-weight: 600;
    color: #1C1C1E;
    margin: 0 0 10px;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .ai-age-verify-text-{{ ai_gen_id }} {
    font-size: 14px;
    color: #6B6B6B;
    line-height: 1.65;
    margin: 0;
  }

  .ai-age-verify-divider-{{ ai_gen_id }} {
    width: 40px;
    height: 1.5px;
    background: linear-gradient(90deg, #F0D060, #D4AF37, #B8903A);
    border-radius: 2px;
    margin: 20px auto;
  }

  .ai-age-verify-buttons-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 20px;
  }

  .ai-age-verify-button-{{ ai_gen_id }} {
    border-radius: 50px;
    padding: 14px 0;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    width: 100%;
    letter-spacing: 0.02em;
    transition: background 0.25s ease, transform 0.2s ease, box-shadow 0.25s ease;
  }

  /* Primary — gold gradient */
  .ai-age-verify-button-yes-{{ ai_gen_id }} {
    background: linear-gradient(135deg, #D4AF37 0%, #B8903A 100%);
    color: #fff;
    border: none;
    box-shadow: 0 4px 18px rgba(212, 175, 55, 0.4);
  }

  .ai-age-verify-button-yes-{{ ai_gen_id }}:hover {
    background: linear-gradient(135deg, #C9A030 0%, #A07828 100%);
    transform: translateY(-1px);
    box-shadow: 0 8px 24px rgba(212, 175, 55, 0.48);
  }

  /* Secondary — white ghost */
  .ai-age-verify-button-no-{{ ai_gen_id }} {
    background: #fff;
    color: #777;
    border: 1px solid #E8E0CC;
    font-size: 14px;
    font-weight: 500;
  }

  .ai-age-verify-button-no-{{ ai_gen_id }}:hover {
    background: #FDFAF0;
    border-color: #D4AF37;
    color: #444;
    transform: translateY(-1px);
  }

  .ai-age-verify-footer-{{ ai_gen_id }} {
    font-size: 11px;
    color: #ABABAB;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid rgba(212, 175, 55, 0.14);
    line-height: 1.5;
  }

  @media (max-width: 749px) {
    .ai-age-verify-popup-{{ ai_gen_id }} {
      padding: 52px 24px 28px;
    }

    .ai-age-verify-heading-{{ ai_gen_id }} {
      font-size: 18px;
    }

    .ai-age-verify-text-{{ ai_gen_id }} {
      font-size: 13px;
    }
  }
{% endstyle %}

<age-verification-{{ ai_gen_id }}>
  <div class="ai-age-verify-overlay-{{ ai_gen_id }}"></div>

  <div class="ai-age-verify-popup-{{ ai_gen_id }}">

    <div class="ai-age-verify-icon-{{ ai_gen_id }}">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        <path d="m9 12 2 2 4-4"/>
      </svg>
    </div>

    <div class="ai-age-verify-brand-{{ ai_gen_id }}">AROUSIQUE</div>

    <h2 class="ai-age-verify-heading-{{ ai_gen_id }}">Age verification</h2>

    <p class="ai-age-verify-text-{{ ai_gen_id }}">
      This website contains content for adults only. Please confirm you are 21 or older to continue.
    </p>

    <div class="ai-age-verify-divider-{{ ai_gen_id }}"></div>

    <div class="ai-age-verify-buttons-{{ ai_gen_id }}">
      <button class="ai-age-verify-button-{{ ai_gen_id }} ai-age-verify-button-yes-{{ ai_gen_id }}" data-action="yes">
        I am 21 or older — enter
      </button>
      <button class="ai-age-verify-button-{{ ai_gen_id }} ai-age-verify-button-no-{{ ai_gen_id }}" data-action="no">
        I am under 21
      </button>
    </div>

    <p class="ai-age-verify-footer-{{ ai_gen_id }}">
      By entering, you agree to our terms and conditions.
    </p>

  </div>
</age-verification-{{ ai_gen_id }}>

<script>
(function() {
  class AgeVerification extends HTMLElement {
    constructor() {
      super();
      this.key = 'ai_age_verified';
      this.overlay = this.querySelector('.ai-age-verify-overlay-default');
      this.popup = this.querySelector('.ai-age-verify-popup-default');
      this.yes = this.querySelector('[data-action="yes"]');
      this.no = this.querySelector('[data-action="no"]');
    }

    connectedCallback() {
      if (!sessionStorage.getItem(this.key)) {
        requestAnimationFrame(() => this.show());
      }

      this.yes.addEventListener('click', () => {
        sessionStorage.setItem(this.key, 'true');
        this.hide();
      });

      this.no.addEventListener('click', () => {
        sessionStorage.setItem('ai_age_blocked', 'true');
        window.location.href = 'https://www.google.com';
      });
    }

    show() {
      this.overlay.classList.add('active');
      this.popup.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    hide() {
      this.overlay.classList.remove('active');
      this.popup.classList.remove('active');
      document.body.style.overflow = '';
    }
  }

  customElements.define('age-verification-default', AgeVerification);
})();
</script>