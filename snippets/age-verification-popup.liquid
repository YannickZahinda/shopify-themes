{% assign ai_gen_id = 'default' %}

{% style %}
  .ai-age-verify-overlay-{{ ai_gen_id }} {
    position: fixed;
    inset: 0;
    background-color: rgba(30, 8, 18, 0.85);
    z-index: 9998;
    display: none;
  }

  .ai-age-verify-overlay-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-age-verify-popup-{{ ai_gen_id }} {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: linear-gradient(160deg, #2a0d1a 0%, #1a0810 100%);
    border: 0.5px solid #6b1e38;
    border-radius: 20px;
    padding: 52px 40px 36px;
    max-width: 420px;
    width: 90%;
    z-index: 9999;
    text-align: center;
    display: none;
  }

  .ai-age-verify-popup-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-age-verify-icon-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 56px;
    height: 56px;
    background: #3d0f22;
    border: 0.5px solid #7b2040;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-age-verify-icon-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
    stroke: #c2547a;
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ai-age-verify-brand-{{ ai_gen_id }} {
    display: inline-block;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #c2547a;
    background: #3d0f22;
    border: 0.5px solid #7b2040;
    border-radius: 20px;
    padding: 4px 14px;
    margin-bottom: 18px;
  }

  .ai-age-verify-heading-{{ ai_gen_id }} {
    font-size: 22px;
    font-weight: 500;
    color: #f5dce7;
    margin: 0 0 10px;
    line-height: 1.3;
  }

  .ai-age-verify-text-{{ ai_gen_id }} {
    font-size: 14px;
    color: #9a6678;
    line-height: 1.6;
    margin: 0;
  }

  .ai-age-verify-divider-{{ ai_gen_id }} {
    width: 40px;
    height: 0.5px;
    background: #6b1e38;
    margin: 20px auto;
  }

  .ai-age-verify-buttons-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 20px;
  }

  .ai-age-verify-button-{{ ai_gen_id }} {
    border-radius: 10px;
    padding: 14px 0;
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
    width: 100%;
    letter-spacing: 0.02em;
    transition: background 0.2s, color 0.2s;
  }

  .ai-age-verify-button-yes-{{ ai_gen_id }} {
    background: #9b2d52;
    color: #fde8f0;
    border: none;
  }

  .ai-age-verify-button-yes-{{ ai_gen_id }}:hover {
    background: #b5365f;
  }

  .ai-age-verify-button-no-{{ ai_gen_id }} {
    background: transparent;
    color: #7a4358;
    border: 0.5px solid #5a2035;
    font-size: 14px;
    font-weight: 400;
  }

  .ai-age-verify-button-no-{{ ai_gen_id }}:hover {
    background: #2a0d1a;
    color: #c2547a;
  }

  .ai-age-verify-footer-{{ ai_gen_id }} {
    font-size: 11px;
    color: #5a2a3a;
    margin-top: 20px;
    line-height: 1.5;
  }

  @media (max-width: 749px) {
    .ai-age-verify-popup-{{ ai_gen_id }} {
      padding: 52px 24px 28px;
    }

    .ai-age-verify-heading-{{ ai_gen_id }} {
      font-size: 18px;
    }

    .ai-age-verify-text-{{ ai_gen_id }} {
      font-size: 13px;
    }
  }
{% endstyle %}

<age-verification-{{ ai_gen_id }}>
  <div class="ai-age-verify-overlay-{{ ai_gen_id }}"></div>

  <div class="ai-age-verify-popup-{{ ai_gen_id }}">

    <div class="ai-age-verify-icon-{{ ai_gen_id }}">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        <path d="m9 12 2 2 4-4"/>
      </svg>
    </div>

    <div class="ai-age-verify-brand-{{ ai_gen_id }}">AROUSIQUE</div>

    <h2 class="ai-age-verify-heading-{{ ai_gen_id }}">Age verification</h2>

    <p class="ai-age-verify-text-{{ ai_gen_id }}">
      This website contains content for adults only. Please confirm you are 21 or older to continue.
    </p>

    <div class="ai-age-verify-divider-{{ ai_gen_id }}"></div>

    <div class="ai-age-verify-buttons-{{ ai_gen_id }}">
      <button class="ai-age-verify-button-{{ ai_gen_id }} ai-age-verify-button-yes-{{ ai_gen_id }}" data-action="yes">
        I am 21 or older — enter
      </button>
      <button class="ai-age-verify-button-{{ ai_gen_id }} ai-age-verify-button-no-{{ ai_gen_id }}" data-action="no">
        I am under 21
      </button>
    </div>

    <p class="ai-age-verify-footer-{{ ai_gen_id }}">
      By entering, you agree to our terms and conditions.
    </p>

  </div>
</age-verification-{{ ai_gen_id }}>

<script>
(function() {
  class AgeVerification extends HTMLElement {
    constructor() {
      super();
      this.key = 'ai_age_verified';
      this.overlay = this.querySelector('.ai-age-verify-overlay-default');
      this.popup = this.querySelector('.ai-age-verify-popup-default');
      this.yes = this.querySelector('[data-action="yes"]');
      this.no = this.querySelector('[data-action="no"]');
    }

    connectedCallback() {
      if (!sessionStorage.getItem(this.key)) {
        this.show();
      }

      this.yes.addEventListener('click', () => {
        sessionStorage.setItem(this.key, 'true');
        this.hide();
      });

      this.no.addEventListener('click', () => {
        sessionStorage.setItem('ai_age_blocked', 'true');
        window.location.href = 'https://www.google.com';
      });
    }

    show() {
      this.overlay.classList.add('active');
      this.popup.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    hide() {
      this.overlay.classList.remove('active');
      this.popup.classList.remove('active');
      document.body.style.overflow = '';
    }
  }

  customElements.define('age-verification-default', AgeVerification);
})();
</script>