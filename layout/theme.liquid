
<!doctype html>
<html
  class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}"
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    <link
      rel="expect"
      href="#MainContent"
      blocking="render"
      id="view-transition-render-blocker"
    >

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
    <style>
  
  
</style>

    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-MHDK554R');</script>
    <!-- End Google Tag Manager -->
    {% render 'sr-checkout' %}
  </head>
  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MHDK554R"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    {%- comment -%} Wishlist Drawer {%- endcomment -%}
    <div id="wishlist-drawer" class="wishlist-drawer">
      <div class="wishlist-overlay"></div>
      
      <div class="wishlist-container">
        <div class="wishlist-header">
          <h2>My Wishlist</h2>
          <button class="wishlist-close" aria-label="Close wishlist">
            <svg width="20" height="20" viewBox="0 0 20 20">
              <path d="M15 5L5 15M5 5l10 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </button>
        </div>

        <div class="wishlist-body">
          <div id="wishlist-items"></div>
          <div id="wishlist-empty" class="wishlist-empty" style="display: none;">
            <svg width="60" height="60" viewBox="0 0 60 60" fill="none">
              <path d="M30 54L27 51.3C17 42.36 10 36.28 10 28.5C10 22.42 14.42 18 20.5 18C23.74 18 26.91 19.81 29 22.09C31.09 19.81 34.26 18 37.5 18C43.58 18 48 22.42 48 28.5C48 36.28 41 42.36 31 51.3L30 54Z" stroke="currentColor" stroke-width="2"/>
            </svg>
            <p>Your wishlist is empty</p>
            <a href="/collections/all" class="btn-continue-shopping">Continue Shopping</a>
          </div>
        </div>

        <div class="wishlist-footer">
          <button class="btn-view-all">View All Products</button>
        </div>
      </div>
    </div>

    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script
      src="{{ 'critical.js' | asset_url }}"
      type="module"
      async
      blocking="render"
    ></script>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    {% render 'age-verification-popup' %}

    {% sections 'footer-group' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}

    {%- comment -%} Wishlist Drawer JavaScript {%- endcomment -%}
    <script src="{{ 'wishlist-drawer.js' | asset_url }}" defer></script>

    {%- comment -%} Judge.me popup brand styling — click-triggered polling ensures styles apply after Judge.me JS {%- endcomment -%}
    <script>
      (function () {
        var pollTimer = null;
        var pollCount = 0;

        /* Broad selector list — catches whatever element Judge.me actually uses */
        var POPUP_SELECTORS = [
          '#jdgm-popup',
          '.jdgm-popup',
          '.jdgm-rev-form-wrap',
          '.jdgm-rev-form',
          '[class*="jdgm"][class*="popup"]:not([class*="overlay"]):not([class*="close"]):not([class*="btn"])',
          '[id*="jdgm"][id*="popup"]'
        ].join(', ');

        var OVERLAY_SELECTORS = [
          '.jdgm-overlay',
          '[class*="jdgm"][class*="overlay"]',
          '[id*="jdgm"][id*="overlay"]'
        ].join(', ');

        function styleElement(el, styles) {
          Object.keys(styles).forEach(function (k) {
            el.style.setProperty(k.replace(/([A-Z])/g, '-$1').toLowerCase(), styles[k], 'important');
          });
        }

        function applyPopupStyles() {
          var found = false;

          /* Style any overlay backdrop */
          document.querySelectorAll(OVERLAY_SELECTORS).forEach(function (el) {
            styleElement(el, {
              background: 'rgba(26,13,18,0.80)',
              backdropFilter: 'blur(6px)',
              webkitBackdropFilter: 'blur(6px)',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              padding: '20px'
            });
            found = true;
          });

          /* Style the popup card */
          document.querySelectorAll(POPUP_SELECTORS).forEach(function (el) {
            /* Skip if this element is actually a full-screen overlay (large area) */
            var rect = el.getBoundingClientRect();
            var isFullscreen = rect.width > window.innerWidth * 0.95 && rect.height > window.innerHeight * 0.95;

            if (isFullscreen) {
              /* It IS the full-screen overlay — give it a dark backdrop and flex-center children */
              styleElement(el, {
                background: 'rgba(26,13,18,0.80)',
                backdropFilter: 'blur(6px)',
                webkitBackdropFilter: 'blur(6px)',
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'center'
              });

              /* Find the first significant child to use as the white card */
              var children = el.children;
              for (var i = 0; i < children.length; i++) {
                var child = children[i];
                var childRect = child.getBoundingClientRect();
                /* Skip tiny elements (close button, scripts, etc.) */
                if (childRect.width > 200 && childRect.height > 150) {
                  styleElement(child, {
                    background: '#ffffff',
                    borderRadius: '20px',
                    boxShadow: '0 24px 80px rgba(26,13,18,0.30)',
                    padding: '40px 36px',
                    maxWidth: '520px',
                    width: '92%',
                    margin: '0',
                    border: 'none',
                    position: 'relative',
                    color: '#1A0D12',
                    webkitTextFillColor: '#1A0D12'
                  });
                  break;
                }
              }
            } else {
              /* It's the card itself — style directly */
              styleElement(el, {
                background: '#ffffff',
                borderRadius: '20px',
                boxShadow: '0 24px 80px rgba(26,13,18,0.30)',
                padding: '40px 36px',
                maxWidth: '520px',
                width: '92%',
                margin: 'auto',
                border: 'none',
                position: 'relative',
                color: '#1A0D12',
                webkitTextFillColor: '#1A0D12'
              });
            }
            found = true;

            /* Dark text on all non-star children */
            el.querySelectorAll('p, h1, h2, h3, h4, h5, label, a').forEach(function (t) {
              if (!t.closest('i.jdgm-star') && !t.classList.contains('jdgm-star')) {
                t.style.setProperty('color', '#1A0D12', 'important');
                t.style.setProperty('-webkit-text-fill-color', '#1A0D12', 'important');
              }
            });
          });

          return found;
        }

        function startPolling() {
          stopPolling();
          pollCount = 0;
          pollTimer = setInterval(function () {
            applyPopupStyles();
            pollCount++;
            if (pollCount > 40) stopPolling(); /* Stop after 4 seconds */
          }, 100);
        }

        function stopPolling() {
          if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
          pollCount = 0;
        }

        /* Start polling whenever any Judge.me "write review" trigger is clicked */
        document.addEventListener('click', function (e) {
          var trigger = e.target.closest(
            '.jdgm-write-rev-link, .jdgm-write-rev-btn, [class*="jdgm"][class*="write"], ' +
            '[class*="jdgm"][class*="rev-btn"], .jdgm-button'
          );
          if (trigger) startPolling();
        }, true);

        /* Also watch for DOM insertions/visibility changes as fallback */
        var observer = new MutationObserver(function (mutations) {
          mutations.forEach(function (m) {
            var relevant = false;
            m.addedNodes.forEach(function (n) {
              if (n.nodeType === 1) {
                var s = (n.id || '') + ' ' + (n.className || '');
                if (s.indexOf('jdgm') !== -1) relevant = true;
              }
            });
            if (m.type === 'attributes' && m.target) {
              var s = (m.target.id || '') + ' ' + (m.target.className || '');
              if (s.indexOf('jdgm') !== -1) relevant = true;
            }
            if (relevant) startPolling();
          });
        });

        document.addEventListener('DOMContentLoaded', function () {
          observer.observe(document.body, {
            childList: true,
            subtree: true,
            attributes: true,
            attributeFilter: ['style', 'class', 'hidden', 'aria-hidden']
          });
        });
      })();
    </script>
  </body>
</html>
